				"to": 226460
			},
			"text": "但是部分国际品牌或者是国内知名品牌是可以跨多个一级类目"
		},
		{
			"timestamps": {
				"from": "00:03:46,460",
				"to": "00:03:50,920"
			},
			"offsets": {
				"from": 226460,
				"to": 230920
			},
			"text": "大部分企业店铺呢是只有唯一主营类目"
		},
		{
			"timestamps": {
				"from": "00:03:50,920",
				"to": "00:03:53,240"
			},
			"offsets": {
				"from": 230920,
				"to": 233240
			},
			"text": "那我们那再说区别"
		},
		{
			"timestamps": {
				"from": "00:03:53,240",
				"to": "00:03:58,040"
			},
			"offsets": {
				"from": 233240,
				"to": 238040
			},
			"text": "像旗舰店呢它是需要有品牌独占授权加资质"
		},
		{
			"timestamps": {
				"from": "00:03:58,040",
				"to": "00:04:00,740"
			},
			"offsets": {
				"from": 238040,
				"to": 240740
			},
			"text": "邀约类目是需要定向开通的"
		},
		{
			"timestamps": {
				"from": "00:04:00,740",
				"to": "00:04:02,040"
			},
			"offsets": {
				"from": 240740,
				"to": 242040
			},
			"text": "什么叫独占授权"
		},
		{
			"timestamps": {
				"from": "00:04:02,040",
				"to": "00:04:06,100"
			},
			"offsets": {
				"from": 242040,
				"to": 246100
			},
			"text": "比如说我们拿到了三只松鼠"
		},
		{
			"timestamps": {
				"from": "00:04:06,100",
				"to": "00:04:10,120"
			},
			"offsets": {
				"from": 246100,
				"to": 250120
			},
			"text": "那就是三只松鼠官方旗舰店"
		},
		{
			"timestamps": {
				"from": "00:04:10,120",
				"to": "00:04:14,140"
			},
			"offsets": {
				"from": 250120,
				"to": 254140
			},
			"text": "那只能允许一个品牌它只能允许"
		},
		{
			"timestamps": {
				"from": "00:04:14,320",
				"to": "00:04:16,740"
			},
			"offsets": {
				"from": 254320,
				"to": 256740
			},
			"text": "平台开设一家官方旗舰店"
		},
		{
			"timestamps": {
				"from": "00:04:16,740",
				"to": "00:04:18,620"
			},
			"offsets": {
				"from": 256740,
				"to": 258620
			},
			"text": "它是需要有独占授权"
		},
		{
			"timestamps": {
				"from": "00:04:18,620",
				"to": "00:04:20,040"
			},
			"offsets": {
				"from": 258620,
				"to": 260040
			},
			"text": "专卖店呢"
		},
		{
			"timestamps": {
				"from": "00:04:20,040",
				"to": "00:04:24,040"
			},
			"offsets": {
				"from": 260040,
				"to": 264040
			},
			"text": "它也是需要有唯一主营类目且不可跨类目"
		},
		{
			"timestamps": {
				"from": "00:04:24,040",
				"to": "00:04:26,040"
			},
			"offsets": {
				"from": 264040,
				"to": 266040
			},
			"text": "但是呢它是可以限制什么"
		},
		{
			"timestamps": {
				"from": "00:04:26,040",
				"to": "00:04:27,680"
			},
			"offsets": {
				"from": 266040,
				"to": 267680
			},
			"text": "有单一品牌授权"
		},
		{
			"timestamps": {
				"from": "00:04:27,680",
				"to": "00:04:32,340"
			},
			"offsets": {
				"from": 267680,
				"to": 272340
			},
			"text": "某某专卖店就只能卖这个品牌旗下的"
		},
		{
			"timestamps": {
				"from": "00:04:32,340",
				"to": "00:04:35,900"
			},
			"offsets": {
				"from": 272340,
				"to": 275900
			},
			"text": "且单一类目主营类目旗下的商品"
		},
		{
			"timestamps": {
				"from": "00:04:35,900",
				"to": "00:04:40,960"
			},
			"offsets": {
				"from": 275900,
				"to": 280960
			},
			"text": "那专营店的区别跟以上这两个店的区别最大在于哪呢"
		},
		{
			"timestamps": {
				"from": "00:04:40,960",
				"to": "00:04:42,620"
			},
			"offsets": {
				"from": 280960,
				"to": 282620
			},
			"text": "它是可以多品牌授权"
		},
		{
			"timestamps": {
				"from": "00:04:42,620",
				"to": "00:04:44,980"
			},
			"offsets": {
				"from": 282620,
				"to": 284980
			},
			"text": "虽然也是唯一主营类目"
		},
		{
			"timestamps": {
				"from": "00:04:44,980",
				"to": "00:04:47,840"
			},
			"offsets": {
				"from": 284980,
				"to": 287840
			},
			"text": "但是只要是这个主营类目旗下"
		},
		{
			"timestamps": {
				"from": "00:04:47,840",
				"to": "00:04:50,060"
			},
			"offsets": {
				"from": 287840,
				"to": 290060
			},
			"text": "它可以存在有不同品牌"
		},
		{
			"timestamps": {
				"from": "00:04:50,060",
				"to": "00:04:51,520"
			},
			"offsets": {
				"from": 290060,
				"to": 291520
			},
			"text": "比如说做家访的"
		},
		{
			"timestamps": {
				"from": "00:04:51,520",
				"to": "00:04:54,800"
			},
			"offsets": {
				"from": 291520,
				"to": 294800
			},
			"text": "它可以有A品牌的授权"
		},
		{
			"timestamps": {
				"from": "00:04:54,800",
				"to": "00:04:56,720"
			},
			"offsets": {
				"from": 294800,
				"to": 296720
			},
			"text": "再上架B品牌"
		},
		{
			"timestamps": {
				"from": "00:04:56,720",
				"to": "00:04:58,500"
			},
			"offsets": {
				"from": 296720,
				"to": 298500
			},
			"text": "只要它有B品牌的授权"
		},
		{
			"timestamps": {
				"from": "00:04:58,500",
				"to": "00:04:59,420"
			},
			"offsets": {
				"from": 298500,
				"to": 299420
			},
			"text": "它也可以上架"
		},
		{
			"timestamps": {
				"from": "00:04:59,420",
				"to": "00:05:02,920"
			},
			"offsets": {
				"from": 299420,
				"to": 302920
			},
			"text": "它是有多个品牌组成的一个品牌店铺"
		},
		{
			"timestamps": {
				"from": "00:05:02,920",
				"to": "00:05:04,160"
			},
			"offsets": {
				"from": 302920,
				"to": 304160
			},
			"text": "就是专营店"
		},
		{
			"timestamps": {
				"from": "00:05:04,160",
				"to": "00:05:06,260"
			},
			"offsets": {
				"from": 304160,
				"to": 306260
			},
			"text": "那像品牌店铺的话"
		},
		{
			"timestamps": {
				"from": "00:05:06,260",
				"to": "00:05:08,660"
			},
			"offsets": {
				"from": 306260,
				"to": 308660
			},
			"text": "因为它的类目是唯一性的"
		},
		{
			"timestamps": {
				"from": "00:05:08,660",
				"to": "00:05:10,820"
			},
			"offsets": {
				"from": 308660,
				"to": 310820
			},
			"text": "所以呢它适合的人群是什么呢"
		},
		{
			"timestamps": {
				"from": "00:05:10,820",
				"to": "00:05:13,800"
			},
			"offsets": {
				"from": 310820,
				"to": 313800
			},
			"text": "品牌方或者是授权的经销商"
		},
		{
			"timestamps": {
				"from": "00:05:13,800",
				"to": "00:05:18,100"
			},
			"offsets": {
				"from": 313800,
				"to": 318100
			},
			"text": "或者是追求品牌权重与流量扶持的商家"
		},
		{
			"timestamps": {
				"from": "00:05:18,100",
				"to": "00:05:21,280"
			},
			"offsets": {
				"from": 318100,
				"to": 321280
			},
			"text": "大家都知道像品牌店铺的话"
		},
		{
			"timestamps": {
				"from": "00:05:21,280",
				"to": "00:05:23,860"
			},
			"offsets": {
				"from": 321280,
				"to": 323860
			},
			"text": "它是具备一定的品牌效益"
		},
		{
			"timestamps": {
				"from": "00:05:23,860",
				"to": "00:05:27,180"
			},
			"offsets": {
				"from": 323860,
				"to": 327180
			},
			"text": "它是有自己追随的特定人群"
		},
		{
			"timestamps": {
				"from": "00:05:27,180",
				"to": "00:05:31,720"
			},
			"offsets": {
				"from": 327180,
				"to": 331720
			},
			"text": "或者是一些黑标店铺平台都是具备有流量倾斜的"
		},
		{
			"timestamps": {
				"from": "00:05:31,720",
				"to": "00:05:33,300"
			},
			"offsets": {
				"from": 331720,
				"to": 333300
			},
			"text": "或者是有什么呢"
		},
		{
			"timestamps": {
				"from": "00:05:33,300",
				"to": "00:05:35,540"
			},
			"offsets": {
				"from": 333300,
				"to": 335540
			},
			"text": "企业店铺但是有自己的商标"
		},
		{
			"timestamps": {
				"from": "00:05:35,540",
				"to": "00:05:38,700"
			},
			"offsets": {
				"from": 335540,
				"to": 338700
			},
			"text": "且长期想在拼多多经营的商家"
		},
		{
			"timestamps": {
				"from": "00:05:38,700",
				"to": "00:05:42,340"
			},
			"offsets": {
				"from": 338700,
				"to": 342340
			},
			"text": "我未来是想奔着黑标的方向去的"
		},
		{
			"timestamps": {
				"from": "00:05:42,340",
				"to": "00:05:45,800"
			},
			"offsets": {
				"from": 342340,
				"to": 345800
			},
			"text": "那这种也是可以选择我们的品牌店铺"
		},
		{
			"timestamps": {
				"from": "00:05:45,800",
				"to": "00:05:48,640"
			},
			"offsets": {
				"from": 345800,
				"to": 348640
			},
			"text": "那第四种呢就是多多国际店"
		},
		{
			"timestamps": {
				"from": "00:05:48,640",
				"to": "00:05:52,200"
			},
			"offsets": {
				"from": 348640,
				"to": 352200
			},
			"text": "多多国际店目前在拼多多平台"
		},
		{
			"timestamps": {
				"from": "00:05:52,200",
				"to": "00:05:55,940"
			},
			"offsets": {
				"from": 352200,
				"to": 355940
			},
			"text": "它是限制只有境外的营业执照"
		},
		{
			"timestamps": {
				"from": "00:05:55,940",
				"to": "00:05:57,120"
			},
			"offsets": {
				"from": 355940,
				"to": 357120
			},
			"text": "它才可以"
		},
		{
			"timestamps": {
				"from": "00:05:57,120",
				"to": "00:05:59,100"
			},
			"offsets": {
				"from": 357120,
				"to": 359100
			},
			"text": "它是限跨境类目"
		},
		{
			"timestamps": {
				"from": "00:05:59,100",
				"to": "00:06:00,320"
			},
			"offsets": {
				"from": 359100,
				"to": 360320
			},
			"text": "限定跨境类目"
		},
		{
			"timestamps": {
				"from": "00:06:00,320",
				"to": "00:06:01,960"
			},
			"offsets": {
				"from": 360320,
				"to": 361960
			},
			"text": "那国内的能不能做呢"
		},
		{
			"timestamps": {
				"from": "00:06:01,960",
				"to": "00:06:02,680"
			},
			"offsets": {
				"from": 361960,
				"to": 362680
			},
			"text": "是不能做的"
		},
		{
			"timestamps": {
				"from": "00:06:02,680",
				"to": "00:06:03,780"
			},
			"offsets": {
				"from": 362680,
				"to": 363780
			},
			"text": "特殊类目的话"
		},
		{
			"timestamps": {
				"from": "00:06:03,780",
				"to": "00:06:07,080"
			},
			"offsets": {
				"from": 363780,
				"to": 367080
			},
			"text": "一样是需要有海关备案一些等等资质"
		},
		{
			"timestamps": {
				"from": "00:06:07,080",
				"to": "00:06:14,120"
			},
			"offsets": {
				"from": 367080,
				"to": 374120
			},
			"text": "那我们了解到了不同不同店铺的类型对于我们类目的一个选择区别以后呢"
		},
		{
			"timestamps": {
				"from": "00:06:14,120",
				"to": "00:06:18,380"
			},
			"offsets": {
				"from": 374120,
				"to": 378380
			},
			"text": "我们如果想要看到我们所有的平台的类目区分"
		},
		{
			"timestamps": {
				"from": "00:06:18,380",
				"to": "00:06:22,360"
			},
			"offsets": {
				"from": 378380,
				"to": 382360
			},
			"text": "我们可以去个人身份证注册一个全类目的店铺"
		},
		{
			"timestamps": {
				"from": "00:06:22,360",
				"to": "00:06:25,260"
			},
			"offsets": {
				"from": 382360,
				"to": 385260
			},
			"text": "这样的话我们可以看到平台的所有类目区分"
		},
		{
			"timestamps": {
				"from": "00:06:25,260",
				"to": "00:06:32,120"
			},
			"offsets": {
				"from": 385260,
				"to": 392120
			},
			"text": "目前的话以2026年1月份平台发布的一个更新的规则来看"
		},
		{
			"timestamps": {
				"from": "00:06:32,120",
				"to": "00:06:35,300"
			},
			"offsets": {
				"from": 392120,
				"to": 395300
			},
			"text": "我们是一共有45个一级类目"
		},
		{
			"timestamps": {
				"from": "00:06:35,300",
				"to": "00:06:41,440"
			},
			"offsets": {
				"from": 395300,
				"to": 401440
			},
			"text": "包括像服饰香包，数码电器，西配摩托或者是水果生鲜"
		},
		{
			"timestamps": {
				"from": "00:06:41,440",
				"to": "00:06:47,040"
			},
			"offsets": {
				"from": 401440,
				"to": 407040
			},
			"text": "一些特别类目的话它是有一些资质需要大家提供的"
		},
		{
			"timestamps": {
				"from": "00:06:47,040",
				"to": "00:06:49,620"
			},
			"offsets": {
				"from": 407040,
				"to": 409620
			},
			"text": "我们在上传的时候呢"
		},
		{
			"timestamps": {
				"from": "00:06:49,620",
				"to": "00:06:52,620"
			},
			"offsets": {
				"from": 409620,
				"to": 412620
			},
			"text": "一般都会让大家提供到这些东西"
		},
		{
			"timestamps": {
				"from": "00:06:52,620",
				"to": "00:06:56,140"
			},
			"offsets": {
				"from": 412620,
				"to": 416140
			},
			"text": "那第三个是对于我们的类目选择呢"
		},
		{
			"timestamps": {
				"from": "00:06:56,140",
				"to": "00:06:59,800"
			},
			"offsets": {
				"from": 416140,
				"to": 419800
			},
			"text": "除了个人店铺以外呢"
		},
		{
			"timestamps": {
				"from": "00:06:59,800",
				"to": "00:07:01,440"
			},
			"offsets": {
				"from": 419800,
				"to": 421440
			},
			"text": "我们像普通企业店铺呢"
		},
		{
			"timestamps": {
				"from": "00:07:01,440",
				"to": "00:07:03,860"
			},
			"offsets": {
				"from": 421440,
				"to": 423860
			},
			"text": "我们怎么选择都是根据自己商品"
		},
		{
			"timestamps": {
				"from": "00:07:03,860",
				"to": "00:07:09,960"
			},
			"offsets": {
				"from": 423860,
				"to": 429960
			},
			"text": "或者是什么营业执照的一个经营范围进行选择就可以了"
		},
		{
			"timestamps": {
				"from": "00:07:09,960",
				"to": "00:07:12,460"
			},
			"offsets": {
				"from": 429960,
				"to": 432460
			},
			"text": "那在最后我们需要强调一下"
		},
		{
			"timestamps": {
				"from": "00:07:12,460",
				"to": "00:07:13,600"
			},
			"offsets": {
				"from": 432460,
				"to": 433600
			},
			"text": "强调一下"
		},
		{
			"timestamps": {
				"from": "00:07:13,600",
				"to": "00:07:16,020"
			},
			"offsets": {
				"from": 433600,
				"to": 436020
			},
			"text": "比如说有哪些规则"
		},
		{
			"timestamps": {
				"from": "00:07:16,020",
				"to": "00:07:18,320"
			},
			"offsets": {
				"from": 436020,
				"to": 438320
			},
			"text": "像我们的主营类目修改"
		},
		{
			"timestamps": {
				"from": "00:07:18,320",
				"to": "00:07:21,980"
			},
			"offsets": {
				"from": 438320,
				"to": 441980
			},
			"text": "有一些客户他可能是注册完了店铺以后呢"
		},
		{
			"timestamps": {
				"from": "00:07:21,980",
				"to": "00:07:23,360"
			},
			"offsets": {
				"from": 441980,
				"to": 443360
			},
			"text": "会发现自己的主营类目"
		},
		{
			"timestamps": {
				"from": "00:07:23,360",
				"to": "00:07:26,220"
			},
			"offsets": {
				"from": 443360,
				"to": 446220
			},
			"text": "想要修改或者是点击错误"
		},
		{
			"timestamps": {
				"from": "00:07:26,220",
				"to": "00:07:27,700"
			},
			"offsets": {
				"from": 446220,
				"to": 447700
			},
			"text": "那这种情况下呢"
		},
		{
			"timestamps": {
				"from": "00:07:27,700",
				"to": "00:07:28,640"
			},
			"offsets": {
				"from": 447700,
				"to": 448640
			},
			"text": "可不可以修改呢"
		},
		{
			"timestamps": {
				"from": "00:07:28,640",
				"to": "00:07:29,540"
			},
			"offsets": {
				"from": 448640,
				"to": 449540
			},
			"text": "是可以的"
		},
		{
			"timestamps": {
				"from": "00:07:29,540",
				"to": "00:07:32,000"
			},
			"offsets": {
				"from": 449540,
				"to": 452000
			},
			"text": "比如说所有店铺入住后呢"
		},
		{
			"timestamps": {
				"from": "00:07:32,000",
				"to": "00:07:35,720"
			},
			"offsets": {
				"from": 452000,
				"to": 455720
			},
			"text": "可修改一次只有一次机会可以修改主营类目"
		},
		{
			"timestamps": {
				"from": "00:07:35,720",
				"to": "00:07:37,560"
			},
			"offsets": {
				"from": 455720,
				"to": 457560
			},
			"text": "并且修改以后呢"
		},
		{
			"timestamps": {
				"from": "00:07:37,560",
				"to": "00:07:38,400"
			},
			"offsets": {
				"from": 457560,
				"to": 458400
			},
			"text": "不可再改"
		},
		{
			"timestamps": {
				"from": "00:07:38,400",
				"to": "00:07:40,380"
			},
			"offsets": {
				"from": 458400,
				"to": 460380
			},
			"text": "修改需要满足无销量"
		},
		{
			"timestamps": {
				"from": "00:07:40,380",
				"to": "00:07:41,860"
			},
			"offsets": {
				"from": 460380,
				"to": 461860
			},
			"text": "无商品数据"
		},
		{
			"timestamps": {
				"from": "00:07:41,860",
				"to": "00:07:44,060"
			},
			"offsets": {
				"from": 461860,
				"to": 464060
			},
			"text": "以缴纳保证金等条件"
		},
		{
			"timestamps": {
				"from": "00:07:44,060",
				"to": "00:07:46,540"
			},
			"offsets": {
				"from": 464060,
				"to": 466540
			},
			"text": "满足了这些条件才能点击修改"
		},
		{
			"timestamps": {
				"from": "00:07:46,540",
				"to": "00:07:49,420"
			},
			"offsets": {
				"from": 466540,
				"to": 469420
			},
			"text": "审核需要人工审核七个工作日"
		},
		{
			"timestamps": {
				"from": "00:07:49,420",
				"to": "00:07:51,400"
			},
			"offsets": {
				"from": 469420,
				"to": 471400
			},
			"text": "它在七个工作日之内"
		},
		{
			"timestamps": {
				"from": "00:07:51,400",
				"to": "00:07:55,940"
			},
			"offsets": {
				"from": 471400,
				"to": 475940
			},
			"text": "一般会提前在两三个工作日就会审核成功"
		},
		{
			"timestamps": {
				"from": "00:07:55,940",
				"to": "00:07:57,180"
			},
			"offsets": {
				"from": 475940,
				"to": 477180
			},
			"text": "怎么操作呢"
		},
		{
			"timestamps": {
				"from": "00:07:57,180",
				"to": "00:07:58,800"
			},
			"offsets": {
				"from": 477180,
				"to": 478800
			},
			"text": "这里给大家演示一下"
		},
		{
			"timestamps": {
				"from": "00:07:58,800",
				"to": "00:08:01,440"
			},
			"offsets": {
				"from": 478800,
				"to": 481440
			},
			"text": "我们打开我们的店铺后台"
		},
		{
			"timestamps": {
				"from": "00:08:01,440",
				"to": "00:08:04,540"
			},
			"offsets": {
				"from": 481440,
				"to": 484540
			},
			"text": "这里有一个店铺管理"
		},
		{
			"timestamps": {
				"from": "00:08:04,540",
				"to": "00:08:05,540"
			},
			"offsets": {
				"from": 484540,
				"to": 485540
			},
			"text": "店铺信息"
		},
		{
			"timestamps": {
				"from": "00:08:05,540",
				"to": "00:08:06,740"
			},
			"offsets": {
				"from": 485540,
				"to": 486740
			},
			"text": "店铺信息这里"
		},
		{
			"timestamps": {
				"from": "00:08:06,740",
				"to": "00:08:10,460"
			},
			"offsets": {
				"from": 486740,
				"to": 490460
			},
			"text": "基本信息下面这里就可以更改主营类目"
		},
		{
			"timestamps": {
				"from": "00:08:10,460",
				"to": "00:08:13,400"
			},
			"offsets": {
				"from": 490460,
				"to": 493400
			},
			"text": "包括一些邀约类目管控"
		},
		{
			"timestamps": {
				"from": "00:08:13,400",
				"to": "00:08:15,180"
			},
			"offsets": {
				"from": 493400,
				"to": 495180
			},
			"text": "这些是有管控的"
		},
		{
			"timestamps": {
				"from": "00:08:15,180",
				"to": "00:08:16,520"
			},
			"offsets": {
				"from": 495180,
				"to": 496520
			},
			"text": "哪些属于邀约类目"
		},
		{
			"timestamps": {
				"from": "00:08:16,520",
				"to": "00:08:18,040"
			},
			"offsets": {
				"from": 496520,
				"to": 498040
			},
			"text": "像充值的"
		},
		{
			"timestamps": {
				"from": "00:08:18,040",
				"to": "00:08:19,780"
			},
			"offsets": {
				"from": 498040,
				"to": 499780
			},
			"text": "游戏生活缴费"
		},
		{
			"timestamps": {
				"from": "00:08:19,780",
				"to": "00:08:23,240"
			},
			"offsets": {
				"from": 499780,
				"to": 503240
			},
			"text": "医药健康或者是二手车"
		},
		{
			"timestamps": {
				"from": "00:08:23,240",
				"to": "00:08:24,120"
			},
			"offsets": {
				"from": 503240,
				"to": 504120
			},
			"text": "新车等"
		},
		{
			"timestamps": {
				"from": "00:08:24,120",
				"to": "00:08:25,560"
			},
			"offsets": {
				"from": 504120,
				"to": 505560
			},
			"text": "它都是为邀约类目"
		},
		{
			"timestamps": {
				"from": "00:08:25,560",
				"to": "00:08:26,860"
			},
			"offsets": {
				"from": 505560,
				"to": 506860
			},
			"text": "像这些邀约类目"
		},
		{
			"timestamps": {
				"from": "00:08:26,860",
				"to": "00:08:27,860"
			},
			"offsets": {
				"from": 506860,
				"to": 507860
			},
			"text": "像个人店"
		},
		{
			"timestamps": {
				"from": "00:08:27,860",
				"to": "00:08:29,280"
			},
			"offsets": {
				"from": 507860,
				"to": 509280
			},
			"text": "它是不可以入住的"
		},
		{
			"timestamps": {
				"from": "00:08:29,280",
				"to": "00:08:35,300"
			},
			"offsets": {
				"from": 509280,
				"to": 515300
			},
			"text": "它仅限于企业店铺 是含品牌店在内的企业店铺才可以申请"
		},
		{
			"timestamps": {
				"from": "00:08:35,300",
				"to": "00:08:41,840"
			},
			"offsets": {
				"from": 515300,
				"to": 521840
			},
			"text": "并且是需要向平台提供资质 以及提供资质以后需要人工审核"
		},
		{
			"timestamps": {
				"from": "00:08:41,840",
				"to": "00:08:48,520"
			},
			"offsets": {
				"from": 521840,
				"to": 528520
			},
			"text": "过了以后才能去进行一些修改呀 或者是入住之类的"
		},
		{
			"timestamps": {
				"from": "00:08:48,520",
				"to": "00:08:52,960"
			},
			"offsets": {
				"from": 528520,
				"to": 532960
			},
			"text": "那在这里呢 我们也要强调一点挫放类目的风险啊"
		},
		{
			"timestamps": {
				"from": "00:08:52,960",
				"to": "00:08:57,360"
			},
			"offsets": {
				"from": 532960,
				"to": 537360
			},
			"text": "挫放类目呢 其实它是我个人理解是可以分成两个板块的"
		},
		{
			"timestamps": {
				"from": "00:08:57,360",
				"to": "00:09:01,320"
			},
			"offsets": {
				"from": 537360,
				"to": 541320
			},
			"text": "一种是什么 常规的 常规的挫类目"
		},
		{
			"timestamps": {
				"from": "00:09:01,320",
				"to": "00:09:04,080"
			},
			"offsets": {
				"from": 541320,
				"to": 544080
			},
			"text": "你像我刚刚举的例子 我们的劳保手套"
		},
		{
			"timestamps": {
				"from": "00:09:04,080",
				"to": "00:09:07,600"
			},
			"offsets": {
				"from": 544080,
				"to": 547600
			},
			"text": "它这个商品 如果你是一家个人店"
		},
		{
			"timestamps": {
				"from": "00:09:07,600",
				"to": "00:09:12,100"
			},
			"offsets": {
				"from": 547600,
				"to": 552100
			},
			"text": "除了企业店 企业店铺的你肯定是只有单一类目可以选择嘛"
		},
		{
			"timestamps": {
				"from": "00:09:12,100",
				"to": "00:09:13,740"
			},
			"offsets": {
				"from": 552100,
				"to": 553740
			},
			"text": "如果是个人店铺的话"
		},
		{
			"timestamps": {
				"from": "00:09:13,740",
				"to": "00:09:19,920"
			},
			"offsets": {
				"from": 553740,
				"to": 559920
			},
			"text": "这个款它是可以具备很多种一级大类目的跨类目选择"
		},
		{
			"timestamps": {
				"from": "00:09:19,920",
				"to": "00:09:23,120"
			},
			"offsets": {
				"from": 559920,
				"to": 563120
			},
			"text": "都是有很多相关的类目 都是可以放"
		},
		{
			"timestamps": {
				"from": "00:09:23,120",
				"to": "00:09:27,280"
			},
			"offsets": {
				"from": 563120,
				"to": 567280
			},
			"text": "它是不触碰平台的规则的"
		},
		{
			"timestamps": {
				"from": "00:09:27,280",
				"to": "00:09:30,960"
			},
			"offsets": {
				"from": 567280,
				"to": 570960
			},
			"text": "但是有一些商品 你是个人店"
		},
		{
			"timestamps": {
				"from": "00:09:30,960",
				"to": "00:09:35,160"
			},
			"offsets": {
				"from": 570960,
				"to": 575160
			},
			"text": "你比如说手机壳 你想放在家居日用 可以"
		},
		{
			"timestamps": {
				"from": "00:09:35,160",
				"to": "00:09:38,620"
			},
			"offsets": {
				"from": 575160,
				"to": 578620
			},
			"text": "你想放在五金能不能放 也可以放"
		},
		{
			"timestamps": {
				"from": "00:09:38,620",
				"to": "00:09:40,700"
			},
			"offsets": {
				"from": 578620,
				"to": 580700
			},
			"text": "这是一种错类目的玩法"
		},
		{
			"timestamps": {
				"from": "00:09:40,700",
				"to": "00:09:44,560"
			},
			"offsets": {
				"from": 580700,
				"to": 584560
			},
			"text": "但是像这种非常规玩法呢"
		},
		{
			"timestamps": {
				"from": "00:09:44,560",
				"to": "00:09:46,760"
			},
			"offsets": {
				"from": 584560,
				"to": 586760
			},
			"text": "它是具备一定风险的"
		},
		{
			"timestamps": {
				"from": "00:09:46,760",
				"to": "00:09:50,560"
			},
			"offsets": {
				"from": 586760,
				"to": 590560
			},
			"text": "没有被抓到的情况下 你可能会起链接会非常快"
		},
		{
			"timestamps": {
				"from": "00:09:50,560",
				"to": "00:09:52,640"
			},
			"offsets": {
				"from": 590560,
				"to": 592640
			},
			"text": "因为你错放类目的话"
		},
		{
			"timestamps": {
				"from": "00:09:52,640",
				"to": "00:09:56,840"
			},
			"offsets": {
				"from": 592640,
				"to": 596840
			},
			"text": "你是等于说错开了一个竞品的直接竞争 会非常快"
		},
		{
			"timestamps": {
				"from": "00:09:56,840",
				"to": "00:10:01,400"
			},
			"offsets": {
				"from": 596840,
				"to": 601400
			},
			"text": "但是如果被抓到的情况下呢 平台会给你提醒"
		},
		{
			"timestamps": {
				"from": "00:10:01,400",
				"to": "00:10:08,240"
			},
			"offsets": {
				"from": 601400,
				"to": 608240
			},
			"text": "如果你不改的话 不在一定时间内改呢 会被下架商品或者是直接是降权"
		},
		{
			"timestamps": {
				"from": "00:10:08,240",
				"to": "00:10:12,120"
			},
			"offsets": {
				"from": 608240,
				"to": 612120
			},
			"text": "所以呢 这里是分两个情况来说的"
		},
		{
			"timestamps": {
				"from": "00:10:12,120",
				"to": "00:10:17,200"
			},
			"offsets": {
				"from": 612120,
				"to": 617200
			},
			"text": "还有一个呢 就是我们类目不同的话 保证金也是有差异的"
		},
		{
			"timestamps": {
				"from": "00:10:17,200",
				"to": "00:10:20,960"
			},
			"offsets": {
				"from": 617200,
				"to": 620960
			},
			"text": "基础保证金我们是500块钱 上一节课有介绍到"
		},
		{
			"timestamps": {
				"from": "00:10:20,960",
				"to": "00:10:28,400"
			},
			"offsets": {
				"from": 620960,
				"to": 628400
			},
			"text": "但是比如说特殊类目有哪些 像水果生鲜呀 酒类呀 虚拟商品呀 什么美妆呀"
		},
		{
			"timestamps": {
				"from": "00:10:28,400",
				"to": "00:10:33,440"
			},
			"offsets": {
				"from": 628400,
				"to": 633440
			},
			"text": "这些的话是不是500块钱就可以了 需要额外补缴类目保证金"
		},
		{
			"timestamps": {
				"from": "00:10:33,440",
				"to": "00:10:38,380"
			},
			"offsets": {
				"from": 633440,
				"to": 638380
			},
			"text": "这一点大家一定要明白 得根据你想操作的商品来定"
		},
		{
			"timestamps": {
				"from": "00:10:38,380",
				"to": "00:10:43,820"
			},
			"offsets": {
				"from": 638380,
				"to": 643820
			},
			"text": "那今天呢 这节课的内容就到此结束 下节课再见"
		}
	]
}
