			},
			"offsets": {
				"from": 245240,
				"to": 247400
			},
			"text": "这个时候我们去申请退店"
		},
		{
			"timestamps": {
				"from": "00:04:07,400",
				"to": "00:04:12,160"
			},
			"offsets": {
				"from": 247400,
				"to": 252160
			},
			"text": "那么我们平台呢就会给到30天的一个监测周期"
		},
		{
			"timestamps": {
				"from": "00:04:12,160",
				"to": "00:04:15,160"
			},
			"offsets": {
				"from": 252160,
				"to": 255160
			},
			"text": "这个30天监测周期过了以后呢"
		},
		{
			"timestamps": {
				"from": "00:04:15,160",
				"to": "00:04:17,240"
			},
			"offsets": {
				"from": 255160,
				"to": 257240
			},
			"text": "这笔钱就是可以退回的"
		},
		{
			"timestamps": {
				"from": "00:04:17,240",
				"to": "00:04:18,640"
			},
			"offsets": {
				"from": 257240,
				"to": 258640
			},
			"text": "还有一种方式"
		},
		{
			"timestamps": {
				"from": "00:04:18,640",
				"to": "00:04:26,320"
			},
			"offsets": {
				"from": 258640,
				"to": 266320
			},
			"text": "是就算不退店的话只要店铺的运营是稳定的正常的没有任何异常也能申请解冻"
		},
		{
			"timestamps": {
				"from": "00:04:26,320",
				"to": "00:04:29,920"
			},
			"offsets": {
				"from": 266320,
				"to": 269920
			},
			"text": "把解冻的保证金变成可用的余额提现"
		},
		{
			"timestamps": {
				"from": "00:04:29,920",
				"to": "00:04:33,120"
			},
			"offsets": {
				"from": 269920,
				"to": 273120
			},
			"text": "那这里需要有一个重点提醒"
		},
		{
			"timestamps": {
				"from": "00:04:33,120",
				"to": "00:04:35,120"
			},
			"offsets": {
				"from": 273120,
				"to": 275120
			},
			"text": "就是退保证金的时候啊"
		},
		{
			"timestamps": {
				"from": "00:04:35,120",
				"to": "00:04:38,480"
			},
			"offsets": {
				"from": 275120,
				"to": 278480
			},
			"text": "银行卡的信息必须和入住时的信息是一致的"
		},
		{
			"timestamps": {
				"from": "00:04:38,480",
				"to": "00:04:43,280"
			},
			"offsets": {
				"from": 278480,
				"to": 283280
			},
			"text": "不然的话会导致金额延迟到账甚至退不出去"
		},
		{
			"timestamps": {
				"from": "00:04:43,280",
				"to": "00:04:46,760"
			},
			"offsets": {
				"from": 283280,
				"to": 286760
			},
			"text": "之前我们就有遇到过有商家因为填错了对公的账户信息"
		},
		{
			"timestamps": {
				"from": "00:04:46,760",
				"to": "00:04:48,760"
			},
			"offsets": {
				"from": 286760,
				"to": 288760
			},
			"text": "白白多等了半个月"
		},
		{
			"timestamps": {
				"from": "00:04:48,760",
				"to": "00:04:51,320"
			},
			"offsets": {
				"from": 288760,
				"to": 291320
			},
			"text": "那么接下来说完店铺保证金了以后啊"
		},
		{
			"timestamps": {
				"from": "00:04:51,320",
				"to": "00:04:53,480"
			},
			"offsets": {
				"from": 291320,
				"to": 293480
			},
			"text": "我们要去介绍一下活动保证金"
		},
		{
			"timestamps": {
				"from": "00:04:53,480",
				"to": "00:04:57,840"
			},
			"offsets": {
				"from": 293480,
				"to": 297840
			},
			"text": "活动保证金这笔钱它不是强制交的"
		},
		{
			"timestamps": {
				"from": "00:04:57,840",
				"to": "00:05:01,460"
			},
			"offsets": {
				"from": 297840,
				"to": 301460
			},
			"text": "只有我们的链接想要去报名平台特定的活动"
		},
		{
			"timestamps": {
				"from": "00:05:01,460",
				"to": "00:05:06,580"
			},
			"offsets": {
				"from": 301460,
				"to": 306580
			},
			"text": "比如说秒杀，九块九特卖或者是竞价像这些的话"
		},
		{
			"timestamps": {
				"from": "00:05:06,580",
				"to": "00:05:10,220"
			},
			"offsets": {
				"from": 306580,
				"to": 310220
			},
			"text": "它才会需要我们去缴纳活动保证金"
		},
		{
			"timestamps": {
				"from": "00:05:10,220",
				"to": "00:05:14,460"
			},
			"offsets": {
				"from": 310220,
				"to": 314460
			},
			"text": "所以活动保证金是准入活动的硬门卡"
		},
		{
			"timestamps": {
				"from": "00:05:14,600",
				"to": "00:05:18,800"
			},
			"offsets": {
				"from": 314600,
				"to": 318800
			},
			"text": "如果没有缴纳或者是不足额直接是没有办法去进行报名的"
		},
		{
			"timestamps": {
				"from": "00:05:18,800",
				"to": "00:05:26,300"
			},
			"offsets": {
				"from": 318800,
				"to": 326300
			},
			"text": "所以活动保证金它是能够确保平台确保我们商家遵守活动规则"
		},
		{
			"timestamps": {
				"from": "00:05:26,300",
				"to": "00:05:31,000"
			},
			"offsets": {
				"from": 326300,
				"to": 331000
			},
			"text": "比如说不擅自换品不虚假宣传"
		},
		{
			"timestamps": {
				"from": "00:05:31,000",
				"to": "00:05:35,200"
			},
			"offsets": {
				"from": 331000,
				"to": 335200
			},
			"text": "能够保证我们在活动产生的订单按时发货"
		},
		{
			"timestamps": {
				"from": "00:05:35,200",
				"to": "00:05:37,860"
			},
			"offsets": {
				"from": 335200,
				"to": 337860
			},
			"text": "那如果要是违规了的情况下"
		},
		{
			"timestamps": {
				"from": "00:05:37,860",
				"to": "00:05:44,320"
			},
			"offsets": {
				"from": 337860,
				"to": 344320
			},
			"text": "平台就会从活动保证金里面扣钱赔付给消费者或者是用以赔偿平台的损失"
		},
		{
			"timestamps": {
				"from": "00:05:44,320",
				"to": "00:05:56,340"
			},
			"offsets": {
				"from": 344320,
				"to": 356340
			},
			"text": "那在2026年的最新规则里面我们的活动保证金分成四个档那第一个档的话是准入门槛最低标准是2000块钱"
		},
		{
			"timestamps": {
				"from": "00:05:56,340",
				"to": "00:06:00,700"
			},
			"offsets": {
				"from": 356340,
				"to": 360700
			},
			"text": "它能够参加的商品额度是一个额度就是比如说一条链接"
		},
		{
			"timestamps": {
				"from": "00:06:00,700",
				"to": "00:06:08,340"
			},
			"offsets": {
				"from": 360700,
				"to": 368340
			},
			"text": "它覆盖的秒杀 净价9块9还有月卡都是可以用的那B档的话就是5000块钱"
		},
		{
			"timestamps": {
				"from": "00:06:08,340",
				"to": "00:06:14,040"
			},
			"offsets": {
				"from": 368340,
				"to": 374040
			},
			"text": "它能够参加两条链接的活动那C档就是2万那像这个档位的话"
		},
		{
			"timestamps": {
				"from": "00:06:14,040",
				"to": "00:06:21,800"
			},
			"offsets": {
				"from": 374040,
				"to": 381800
			},
			"text": "如何选择呢?我们虽然说平台给大家下放的限额是2000块钱就可以去参加了"
		},
		{
			"timestamps": {
				"from": "00:06:21,800",
				"to": "00:06:27,420"
			},
			"offsets": {
				"from": 381800,
				"to": 387420
			},
			"text": "但是我们还是建议如果想去玩活动的是至少缴纳5000块钱"
		},
		{
			"timestamps": {
				"from": "00:06:27,420",
				"to": "00:06:33,240"
			},
			"offsets": {
				"from": 387420,
				"to": 393240
			},
			"text": "那还包括一些大的链接想去参加一些大型秒杀,想去上万人团"
		},
		{
			"timestamps": {
				"from": "00:06:33,240",
				"to": "00:06:39,040"
			},
			"offsets": {
				"from": 393240,
				"to": 399040
			},
			"text": "基本的话它就是得交到2万块钱才能去参加这样的一些大型门槛的秒杀活动"
		},
		{
			"timestamps": {
				"from": "00:06:39,040",
				"to": "00:06:43,760"
			},
			"offsets": {
				"from": 399040,
				"to": 403760
			},
			"text": "那很多商家会问了,比如说我交了店铺保证金,报名"
		},
		{
			"timestamps": {
				"from": "00:06:43,760",
				"to": "00:06:53,260"
			},
			"offsets": {
				"from": 403760,
				"to": 413260
			},
			"text": "活动的时候还需要再交活动保证金吗?答案肯定是需要的,刚刚在前面的话我已经强调过了,两者是独立核算,相互不抵扣的"
		},
		{
			"timestamps": {
				"from": "00:06:53,260",
				"to": "00:07:03,560"
			},
			"offsets": {
				"from": 413260,
				"to": 423560
			},
			"text": "比如说你店铺是普通类目,交了1000块钱,但是你现在想报名秒杀的话,就得单独再交2000块钱以上,或者是5000块钱"
		},
		{
			"timestamps": {
				"from": "00:07:03,560",
				"to": "00:07:13,480"
			},
			"offsets": {
				"from": 423560,
				"to": 433480
			},
			"text": "那这笔钱什么时候去退呢?这笔钱退的会比店铺保证金快,活动结束以后,只要你的活动"
		},
		{
			"timestamps": {
				"from": "00:07:13,480",
				"to": "00:07:18,280"
			},
			"offsets": {
				"from": 433480,
				"to": 438280
			},
			"text": "在周期间订单没有任何违规的情况下,15天就可以申请解冻提现"
		},
		{
			"timestamps": {
				"from": "00:07:18,280",
				"to": "00:07:26,680"
			},
			"offsets": {
				"from": 438280,
				"to": 446680
			},
			"text": "所以活动保证金的资金周转效率还是非常高的,那缴纳活动保证金的路径呢,其实是和店铺保证金是一样的"
		},
		{
			"timestamps": {
				"from": "00:07:26,680",
				"to": "00:07:32,880"
			},
			"offsets": {
				"from": 446680,
				"to": 452880
			},
			"text": "我们在打开商家后台,有一个点击资金管理,这里会有一个保证金"
		},
		{
			"timestamps": {
				"from": "00:07:32,880",
				"to": "00:07:39,680"
			},
			"offsets": {
				"from": 452880,
				"to": 459680
			},
			"text": "活动保证金,左边是店铺保证金,右边是活动保证金,直接点击充值就可以了"
		},
		{
			"timestamps": {
				"from": "00:07:39,680",
				"to": "00:07:43,200"
			},
			"offsets": {
				"from": 459680,
				"to": 463200
			},
			"text": "最后呀,我还是需要给大家强调一下"
		},
		{
			"timestamps": {
				"from": "00:07:43,200",
				"to": "00:07:47,320"
			},
			"offsets": {
				"from": 463200,
				"to": 467320
			},
			"text": "我们要有三个需要逼的坑,都是非常血淋淋的教训"
		},
		{
			"timestamps": {
				"from": "00:07:47,320",
				"to": "00:07:51,460"
			},
			"offsets": {
				"from": 467320,
				"to": 471460
			},
			"text": "第一就是我们千万不要抱有侥幸的心理违规"
		},
		{
			"timestamps": {
				"from": "00:07:51,460",
				"to": "00:07:57,860"
			},
			"offsets": {
				"from": 471460,
				"to": 477860
			},
			"text": "因为之前我们就有遇到过有一个商家因为商品描述不符合去判定的违规"
		},
		{
			"timestamps": {
				"from": "00:07:57,860",
				"to": "00:08:01,880"
			},
			"offsets": {
				"from": 477860,
				"to": 481880
			},
			"text": "不仅店铺会被限制,店铺保证金会被罚"
		},
		{
			"timestamps": {
				"from": "00:08:01,880",
				"to": "00:08:05,560"
			},
			"offsets": {
				"from": 481880,
				"to": 485560
			},
			"text": "然后包括我们的活动保证金也都会被罚"
		},
		{
			"timestamps": {
				"from": "00:08:05,560",
				"to": "00:08:11,540"
			},
			"offsets": {
				"from": 485560,
				"to": 491540
			},
			"text": "还有就是商家因为物流延迟被误判虚假轨迹,保证金也会被动"
		},
		{
			"timestamps": {
				"from": "00:08:11,920",
				"to": "00:08:17,700"
			},
			"offsets": {
				"from": 491920,
				"to": 497700
			},
			"text": "所以在我们平台经营的过程中,一定要遵守规则,有问题的话及时和平台去沟通"
		},
		{
			"timestamps": {
				"from": "00:08:17,700",
				"to": "00:08:21,360"
			},
			"offsets": {
				"from": 497700,
				"to": 501360
			},
			"text": "第二点,就是别混淆金额的档位"
		},
		{
			"timestamps": {
				"from": "00:08:21,360",
				"to": "00:08:27,240"
			},
			"offsets": {
				"from": 501360,
				"to": 507240
			},
			"text": "之前有朋友说保证金2000元,其实大多数是普通类目店保证金"
		},
		{
			"timestamps": {
				"from": "00:08:27,240",
				"to": "00:08:31,600"
			},
			"offsets": {
				"from": 507240,
				"to": 511600
			},
			"text": "那活动保证金的话,默认我们是希望大家能交到5000块钱的"
		},
		{
			"timestamps": {
				"from": "00:08:31,600",
				"to": "00:08:38,440"
			},
			"offsets": {
				"from": 511600,
				"to": 518440
			},
			"text": "报名前一定要看清楚活动业的要求,别因为少交而导致报名失败"
		},
		{
			"timestamps": {
				"from": "00:08:38,440",
				"to": "00:08:42,940"
			},
			"offsets": {
				"from": 518440,
				"to": 522940
			},
			"text": "那第三点的话就是要定期检查活动的状态"
		},
		{
			"timestamps": {
				"from": "00:08:42,940",
				"to": "00:08:48,120"
			},
			"offsets": {
				"from": 522940,
				"to": 528120
			},
			"text": "平台会根据你店铺的月成交金额去调整基础保证金的金额"
		},
		{
			"timestamps": {
				"from": "00:08:48,120",
				"to": "00:08:56,720"
			},
			"offsets": {
				"from": 528120,
				"to": 536720
			},
			"text": "如果成交金额上涨了,保证金没有及时补交,也可能会被限制,上新,提现,甚至是影响活动报名的资格"
		},
		{
			"timestamps": {
				"from": "00:08:56,720",
				"to": "00:08:59,100"
			},
			"offsets": {
				"from": 536720,
				"to": 539100
			},
			"text": "那么最后我们去做一下总结"
		},
		{
			"timestamps": {
				"from": "00:08:59,100",
				"to": "00:09:04,760"
			},
			"offsets": {
				"from": 539100,
				"to": 544760
			},
			"text": "店铺保证金是开店必备的押金,按雷幕取交,可退可解冻"
		},
		{
			"timestamps": {
				"from": "00:09:04,960",
				"to": "00:09:11,120"
			},
			"offsets": {
				"from": 544960,
				"to": 551120
			},
			"text": "活动保证金是活动报名的担保金,按虚交,活动结束,快速解冻"
		},
		{
			"timestamps": {
				"from": "00:09:11,120",
				"to": "00:09:18,560"
			},
			"offsets": {
				"from": 551120,
				"to": 558560
			},
			"text": "15天内,两者都是需要足额交,合规用才能避免资金损失和店铺受限"
		},
		{
			"timestamps": {
				"from": "00:09:18,560",
				"to": "00:09:24,900"
			},
			"offsets": {
				"from": 558560,
				"to": 564900
			},
			"text": "最后本期的视频内容就到这里,咱们下期见"
		}
	]
}
