			"timestamps": {
				"from": "00:12:39,400",
				"to": "00:12:47,560"
			},
			"offsets": {
				"from": 759400,
				"to": 767560
			},
			"text": "你去想一下你陪你的老公老婆女朋友或者是家里面的小孩去商场里面买衣服的行为"
		},
		{
			"timestamps": {
				"from": "00:12:47,560",
				"to": "00:12:52,860"
			},
			"offsets": {
				"from": 767560,
				"to": 772860
			},
			"text": "你就可以理解为商场里面的某一个店就是你在拼多多里面开的某一个店"
		},
		{
			"timestamps": {
				"from": "00:12:52,860",
				"to": "00:12:57,360"
			},
			"offsets": {
				"from": 772860,
				"to": 777360
			},
			"text": "这些顾客会进入到你的店铺里面它是一种漫无目的的行为"
		},
		{
			"timestamps": {
				"from": "00:12:57,360",
				"to": "00:13:03,280"
			},
			"offsets": {
				"from": 777360,
				"to": 783280
			},
			"text": "还有一点的话就是当下的整个拼多多里面推荐的流量是大于搜索流量的A音贝的"
		},
		{
			"timestamps": {
				"from": "00:13:03,280",
				"to": "00:13:04,920"
			},
			"offsets": {
				"from": 783280,
				"to": 784920
			},
			"text": "具体没有很明确的一个标签"
		},
		{
			"timestamps": {
				"from": "00:13:04,920",
				"to": "00:13:08,960"
			},
			"offsets": {
				"from": 784920,
				"to": 788960
			},
			"text": "因为当下的整个拼多多流量入口的关系给大家做了一个图"
		},
		{
			"timestamps": {
				"from": "00:13:08,960",
				"to": "00:13:10,460"
			},
			"offsets": {
				"from": 788960,
				"to": 790460
			},
			"text": "给大家去做了一个图"
		},
		{
			"timestamps": {
				"from": "00:13:10,460",
				"to": "00:13:15,780"
			},
			"offsets": {
				"from": 790460,
				"to": 795780
			},
			"text": "你可以看到整个平台的流量分成了三个板块"
		},
		{
			"timestamps": {
				"from": "00:13:15,780",
				"to": "00:13:18,820"
			},
			"offsets": {
				"from": 795780,
				"to": 798820
			},
			"text": "在搜索推荐里面又分成了三个板块"
		},
		{
			"timestamps": {
				"from": "00:13:18,820",
				"to": "00:13:22,800"
			},
			"offsets": {
				"from": 798820,
				"to": 802800
			},
			"text": "搜索和推荐中间还有个东西叫广告"
		},
		{
			"timestamps": {
				"from": "00:13:22,800",
				"to": "00:13:23,820"
			},
			"offsets": {
				"from": 802800,
				"to": 803820
			},
			"text": "广告的一个推广"
		},
		{
			"timestamps": {
				"from": "00:13:23,820",
				"to": "00:13:27,040"
			},
			"offsets": {
				"from": 803820,
				"to": 807040
			},
			"text": "广告的推广里面既有搜索又有推荐"
		},
		{
			"timestamps": {
				"from": "00:13:27,040",
				"to": "00:13:29,960"
			},
			"offsets": {
				"from": 807040,
				"to": 809960
			},
			"text": "他们是互相去进行影响的"
		},
		{
			"timestamps": {
				"from": "00:13:29,960",
				"to": "00:13:35,800"
			},
			"offsets": {
				"from": 809960,
				"to": 815800
			},
			"text": "也就是2026年的平台的流量获取的核心是广告推广"
		},
		{
			"timestamps": {
				"from": "00:13:35,800",
				"to": "00:13:38,760"
			},
			"offsets": {
				"from": 815800,
				"to": 818760
			},
			"text": "并且它互相影响搜索和推荐"
		},
		{
			"timestamps": {
				"from": "00:13:38,760",
				"to": "00:13:41,660"
			},
			"offsets": {
				"from": 818760,
				"to": 821660
			},
			"text": "还有一个点的话就是它是必要来源"
		},
		{
			"timestamps": {
				"from": "00:13:41,660",
				"to": "00:13:45,260"
			},
			"offsets": {
				"from": 821660,
				"to": 825260
			},
			"text": "记住是必要来源不是主要更不是部分"
		},
		{
			"timestamps": {
				"from": "00:13:45,260",
				"to": "00:13:50,280"
			},
			"offsets": {
				"from": 825260,
				"to": 830280
			},
			"text": "因为这个平台里面的所有的广告的流量"
		},
		{
			"timestamps": {
				"from": "00:13:50,280",
				"to": "00:13:51,920"
			},
			"offsets": {
				"from": 830280,
				"to": 831920
			},
			"text": "你如果一旦停止"
		},
		{
			"timestamps": {
				"from": "00:13:51,920",
				"to": "00:13:54,820"
			},
			"offsets": {
				"from": 831920,
				"to": 834820
			},
			"text": "你的主要来源和你的部分来源全部都会没有"
		},
		{
			"timestamps": {
				"from": "00:13:54,820",
				"to": "00:13:57,140"
			},
			"offsets": {
				"from": 834820,
				"to": 837140
			},
			"text": "会直接让你的链接沉入谷底"
		},
		{
			"timestamps": {
				"from": "00:13:57,140",
				"to": "00:14:00,280"
			},
			"offsets": {
				"from": 837140,
				"to": 840280
			},
			"text": "因为这是当家整个拼多多里面流量的一个结构"
		},
		{
			"timestamps": {
				"from": "00:14:00,280",
				"to": "00:14:02,860"
			},
			"offsets": {
				"from": 840280,
				"to": 842860
			},
			"text": "同时呢 个性化的流量"
		},
		{
			"timestamps": {
				"from": "00:14:02,860",
				"to": "00:14:04,080"
			},
			"offsets": {
				"from": 842860,
				"to": 844080
			},
			"text": "举个很简单的例子"
		},
		{
			"timestamps": {
				"from": "00:14:04,080",
				"to": "00:14:06,340"
			},
			"offsets": {
				"from": 844080,
				"to": 846340
			},
			"text": "我这个产品推荐流量比较多"
		},
		{
			"timestamps": {
				"from": "00:14:06,340",
				"to": "00:14:07,440"
			},
			"offsets": {
				"from": 846340,
				"to": 847440
			},
			"text": "我去做付费"
		},
		{
			"timestamps": {
				"from": "00:14:07,440",
				"to": "00:14:09,840"
			},
			"offsets": {
				"from": 847440,
				"to": 849840
			},
			"text": "我的必要流量来源已经拿到了"
		},
		{
			"timestamps": {
				"from": "00:14:09,840",
				"to": "00:14:10,880"
			},
			"offsets": {
				"from": 849840,
				"to": 850880
			},
			"text": "那么这个时候呢"
		},
		{
			"timestamps": {
				"from": "00:14:10,880",
				"to": "00:14:14,760"
			},
			"offsets": {
				"from": 850880,
				"to": 854760
			},
			"text": "我想拿到更多的主要来源的推荐流量"
		},
		{
			"timestamps": {
				"from": "00:14:14,760",
				"to": "00:14:15,680"
			},
			"offsets": {
				"from": 854760,
				"to": 855680
			},
			"text": "这个时候呢"
		},
		{
			"timestamps": {
				"from": "00:14:15,680",
				"to": "00:14:20,480"
			},
			"offsets": {
				"from": 855680,
				"to": 860480
			},
			"text": "我上秒杀卖9块9和我直接去打强付费9块9"
		},
		{
			"timestamps": {
				"from": "00:14:20,480",
				"to": "00:14:23,160"
			},
			"offsets": {
				"from": 860480,
				"to": 863160
			},
			"text": "我的直动车出价都是一模一样的情况下"
