		{
			"timestamps": {
				"from": "00:14:23,160",
				"to": "00:14:26,080"
			},
			"offsets": {
				"from": 863160,
				"to": 866080
			},
			"text": "人群包的覆盖的质量"
		},
		{
			"timestamps": {
				"from": "00:14:26,080",
				"to": "00:14:28,720"
			},
			"offsets": {
				"from": 866080,
				"to": 868720
			},
			"text": "在白衣补贴里面，资源位里面"
