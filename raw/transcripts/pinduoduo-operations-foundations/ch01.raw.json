				"from": "00:14:54,060",
				"to": "00:14:56,860"
			},
			"offsets": {
				"from": 894060,
				"to": 896860
			},
			"text": "所以这个是拼多多里面流量的核心"
		},
		{
			"timestamps": {
				"from": "00:14:56,860",
				"to": "00:14:57,620"
			},
			"offsets": {
				"from": 896860,
				"to": 897620
			},
			"text": "就是很多人问"
		},
		{
			"timestamps": {
				"from": "00:14:57,620",
				"to": "00:14:59,460"
			},
			"offsets": {
				"from": 897620,
				"to": 899460
			},
			"text": "做拼多多为什么要去做防比价"
