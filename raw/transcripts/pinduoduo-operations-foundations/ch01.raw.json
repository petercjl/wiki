			"timestamps": {
				"from": "00:14:59,460",
				"to": "00:15:00,980"
			},
			"offsets": {
				"from": 899460,
				"to": 900980
			},
			"text": "为什么要去写SKU"
		},
		{
			"timestamps": {
				"from": "00:15:00,980",
				"to": "00:15:02,660"
			},
			"offsets": {
				"from": 900980,
				"to": 902660
			},
			"text": "为什么要去原价卡达醋"
