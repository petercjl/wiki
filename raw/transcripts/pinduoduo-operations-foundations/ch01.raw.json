			"timestamps": {
				"from": "00:15:02,660",
				"to": "00:15:04,400"
			},
			"offsets": {
				"from": 902660,
				"to": 904400
			},
			"text": "为什么要去做品牌的黑标"
		},
		{
			"timestamps": {
				"from": "00:15:04,400",
				"to": "00:15:05,760"
			},
			"offsets": {
				"from": 904400,
				"to": 905760
			},
			"text": "为什么要去上秒杀"
		},
		{
			"timestamps": {
				"from": "00:15:05,760",
				"to": "00:15:06,660"
			},
			"offsets": {
				"from": 905760,
				"to": 906660
			},
			"text": "上9块9"
		},
		{
			"timestamps": {
				"from": "00:15:06,660",
				"to": "00:15:07,520"
			},
			"offsets": {
				"from": 906660,
				"to": 907520
			},
			"text": "上领券中心"
		},
		{
			"timestamps": {
				"from": "00:15:07,520",
				"to": "00:15:10,640"
			},
			"offsets": {
				"from": 907520,
				"to": 910640
			},
