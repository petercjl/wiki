			"timestamps": {
				"from": "00:14:35,260",
				"to": "00:14:35,860"
			},
			"offsets": {
				"from": 875260,
				"to": 875860
			},
			"text": "所以呢"
		},
		{
			"timestamps": {
				"from": "00:14:35,860",
				"to": "00:14:37,440"
			},
			"offsets": {
				"from": 875860,
				"to": 877440
			},
			"text": "个性化流量"
		},
		{
			"timestamps": {
				"from": "00:14:37,440",
				"to": "00:14:38,940"
			},
			"offsets": {
				"from": 877440,
				"to": 878940
			},
			"text": "真正真正的"
		},
