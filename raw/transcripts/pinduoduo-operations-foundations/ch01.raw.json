			"timestamps": {
				"from": "00:14:48,040",
				"to": "00:14:49,880"
			},
			"offsets": {
				"from": 888040,
				"to": 889880
			},
			"text": "就是很多人在信心念念"
		},
		{
			"timestamps": {
				"from": "00:14:49,880",
				"to": "00:14:52,260"
			},
			"offsets": {
				"from": 889880,
				"to": 892260
			},
			"text": "在去追求能不能原价上一个活动"
