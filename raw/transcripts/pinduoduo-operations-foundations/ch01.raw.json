				"from": "00:14:28,720",
				"to": "00:14:30,040"
			},
			"offsets": {
				"from": 868720,
				"to": 870040
			},
			"text": "以及大宿会场里面"
		},
		{
			"timestamps": {
				"from": "00:14:30,040",
				"to": "00:14:31,720"
			},
			"offsets": {
				"from": 870040,
				"to": 871720
			},
			"text": "它的被点击概率"
		},
		{
			"timestamps": {
				"from": "00:14:31,720",
				"to": "00:14:32,820"
			},
			"offsets": {
				"from": 871720,
				"to": 872820
			},
			"text": "被转化的概率"
		},
		{
			"timestamps": {
				"from": "00:14:32,820",
				"to": "00:14:35,260"
			},
			"offsets": {
				"from": 872820,
				"to": 875260
			},
			"text": "以及人群的精准度会更高"
		},
