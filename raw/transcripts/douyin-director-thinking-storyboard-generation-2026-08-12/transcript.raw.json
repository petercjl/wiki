				"from": 367400,
				"to": 369200
			},
			"text": "但是对于新手而言"
		},
		{
			"timestamps": {
				"from": "00:06:09,200",
				"to": "00:06:11,800"
			},
			"offsets": {
				"from": 369200,
				"to": 371800
			},
			"text": "往往分不清笔墨的深浅"
		},
		{
			"timestamps": {
				"from": "00:06:11,800",
				"to": "00:06:13,800"
			},
			"offsets": {
				"from": 371800,
				"to": 373800
			},
			"text": "以及笔墨的重点"
		},
		{
			"timestamps": {
				"from": "00:06:13,800",
				"to": "00:06:16,200"
			},
			"offsets": {
				"from": 373800,
				"to": 376200
			},
			"text": "好咱们再看最后的一杆利"
		},
		{
			"timestamps": {
				"from": "00:06:16,200",
				"to": "00:06:19,200"
			},
			"offsets": {
				"from": 376200,
				"to": 379200
			},
			"text": "此刻小海莉被她姑母给拐跑了"
		},
		{
			"timestamps": {
				"from": "00:06:19,200",
				"to": "00:06:23,200"
			},
			"offsets": {
				"from": 379200,
				"to": 383200
			},
			"text": "咱们看一下镜头是如何表达爷爷此时的状态的"
		},
		{
			"timestamps": {
				"from": "00:06:23,200",
				"to": "00:06:30,400"
			},
			"offsets": {
				"from": 383200,
				"to": 390400
			},
			"text": "好看这正面的跟镜头"
		},
		{
			"timestamps": {
				"from": "00:06:30,400",
				"to": "00:06:32,600"
			},
			"offsets": {
				"from": 390400,
				"to": 392600
			},
			"text": "然后是反面的跟镜头"
		},
		{
			"timestamps": {
				"from": "00:06:32,600",
				"to": "00:06:38,600"
			},
			"offsets": {
				"from": 392600,
				"to": 398600
			},
			"text": "第三镜给到人物的情绪特写"
		},
		{
			"timestamps": {
				"from": "00:06:38,600",
				"to": "00:06:41,000"
			},
			"offsets": {
				"from": 398600,
				"to": 401000
			},
			"text": "再然后给到一个大的环境"
		},
		{
			"timestamps": {
				"from": "00:06:41,000",
				"to": "00:06:43,200"
			},
			"offsets": {
				"from": 401000,
				"to": 403200
			},
			"text": "好以上就是分镜的设计"
		},
		{
			"timestamps": {
				"from": "00:06:43,200",
				"to": "00:06:44,800"
			},
			"offsets": {
				"from": 403200,
				"to": 404800
			},
			"text": "很简单对吧"
		},
		{
			"timestamps": {
				"from": "00:06:44,800",
				"to": "00:06:46,600"
			},
			"offsets": {
				"from": 404800,
				"to": 406600
			},
			"text": "但问题是为什么"
		},
		{
			"timestamps": {
				"from": "00:06:46,600",
				"to": "00:06:49,200"
			},
			"offsets": {
				"from": 406600,
				"to": 409200
			},
			"text": "你看此刻人物是特别焦虑的"
		},
		{
			"timestamps": {
				"from": "00:06:49,200",
				"to": "00:06:52,000"
			},
			"offsets": {
				"from": 409200,
				"to": 412000
			},
			"text": "但是前后的两个跟镜头"
		},
		{
			"timestamps": {
				"from": "00:06:52,000",
				"to": "00:06:54,600"
			},
			"offsets": {
				"from": 412000,
				"to": 414600
			},
			"text": "运动的速度不是很快"
		},
		{
			"timestamps": {
				"from": "00:06:54,600",
				"to": "00:06:55,400"
			},
			"offsets": {
				"from": 414600,
				"to": 415400
			},
			"text": "为什么"
		},
		{
			"timestamps": {
				"from": "00:06:55,400",
				"to": "00:06:57,800"
			},
			"offsets": {
				"from": 415400,
				"to": 417800
			},
			"text": "为了体现出爷爷的无力感"
		},
		{
			"timestamps": {
				"from": "00:06:57,800",
				"to": "00:07:02,600"
			},
			"offsets": {
				"from": 417800,
				"to": 422600
			},
			"text": "最后的这一镜为什么要这样呈现"
		},
		{
			"timestamps": {
				"from": "00:07:02,600",
				"to": "00:07:05,600"
			},
			"offsets": {
				"from": 422600,
				"to": 425600
			},
			"text": "依旧是体现出人物的无力感"
		},
		{
			"timestamps": {
				"from": "00:07:05,600",
				"to": "00:07:08,000"
			},
			"offsets": {
				"from": 425600,
				"to": 428000
			},
			"text": "而这个是另外的一种手法"
		},
		{
			"timestamps": {
				"from": "00:07:08,000",
				"to": "00:07:09,800"
			},
			"offsets": {
				"from": 428000,
				"to": 429800
			},
			"text": "叫做环境压制"
		},
		{
			"timestamps": {
				"from": "00:07:09,800",
				"to": "00:07:11,800"
			},
			"offsets": {
				"from": 429800,
				"to": 431800
			},
			"text": "然后回到爷爷的表情"
		},
		{
			"timestamps": {
				"from": "00:07:11,800",
				"to": "00:07:13,800"
			},
			"offsets": {
				"from": 431800,
				"to": 433800
			},
			"text": "让他继续往回走"
		},
		{
			"timestamps": {
				"from": "00:07:13,800",
				"to": "00:07:15,600"
			},
			"offsets": {
				"from": 433800,
				"to": 435600
			},
			"text": "这个时候如果是你"
		},
		{
			"timestamps": {
				"from": "00:07:15,600",
				"to": "00:07:18,600"
			},
			"offsets": {
				"from": 435600,
				"to": 438600
			},
			"text": "你的镜头设计又会是怎样的"
		},
		{
			"timestamps": {
				"from": "00:07:18,600",
				"to": "00:07:21,600"
			},
			"offsets": {
				"from": 438600,
				"to": 441600
			},
			"text": "这里导演思维继续发挥作用"
		},
		{
			"timestamps": {
				"from": "00:07:21,600",
				"to": "00:07:26,000"
			},
			"offsets": {
				"from": 441600,
				"to": 446000
			},
			"text": "就是用一个长镜头去记录爷爷的情绪"
		},
		{
			"timestamps": {
				"from": "00:07:26,000",
				"to": "00:07:29,600"
			},
			"offsets": {
				"from": 446000,
				"to": 449600
			},
			"text": "因为这个时候情绪是极度浓烈的"
		},
		{
			"timestamps": {
				"from": "00:07:29,600",
				"to": "00:07:31,000"
			},
			"offsets": {
				"from": 449600,
				"to": 451000
			},
			"text": "且无法消化"
		},
		{
			"timestamps": {
				"from": "00:07:41,800",
				"to": "00:07:52,600"
			},
			"offsets": {
				"from": 461800,
				"to": 472600
			},
			"text": "你看这杆里分镜非常简单"
		},
		{
			"timestamps": {
				"from": "00:07:52,600",
				"to": "00:07:56,400"
			},
			"offsets": {
				"from": 472600,
				"to": 476400
			},
			"text": "但是它的核心表达全都在导演思维上"
		},
		{
			"timestamps": {
				"from": "00:07:56,400",
				"to": "00:07:59,800"
			},
			"offsets": {
				"from": 476400,
				"to": 479800
			},
			"text": "首先导演思维决定了动态性的表达"
		},
		{
			"timestamps": {
				"from": "00:07:59,800",
				"to": "00:08:02,000"
			},
			"offsets": {
				"from": 479800,
				"to": 482000
			},
			"text": "这里动态性它是慢的"
		},
		{
			"timestamps": {
				"from": "00:08:02,000",
				"to": "00:08:05,200"
			},
			"offsets": {
				"from": 482000,
				"to": 485200
			},
			"text": "为了表现出爷爷的无可奈何"
		},
		{
			"timestamps": {
				"from": "00:08:05,200",
				"to": "00:08:07,700"
			},
			"offsets": {
				"from": 485200,
				"to": 487700
			},
			"text": "然后这里面还有构图的设计"
		},
		{
			"timestamps": {
				"from": "00:08:07,700",
				"to": "00:08:09,880"
			},
			"offsets": {
				"from": 487700,
				"to": 489880
			},
			"text": "用环境去压制人物"
		},
		{
			"timestamps": {
				"from": "00:08:09,880",
				"to": "00:08:12,340"
			},
			"offsets": {
				"from": 489880,
				"to": 492340
			},
			"text": "第三点就是长镜头的设计"
		},
		{
			"timestamps": {
				"from": "00:08:12,340",
				"to": "00:08:14,940"
			},
			"offsets": {
				"from": 492340,
				"to": 494940
			},
			"text": "什么时候选择用长镜头"
		},
		{
			"timestamps": {
				"from": "00:08:14,940",
				"to": "00:08:17,760"
			},
			"offsets": {
				"from": 494940,
				"to": 497760
			},
			"text": "其实是有时机有原因的"
		},
		{
			"timestamps": {
				"from": "00:08:17,760",
				"to": "00:08:21,220"
			},
			"offsets": {
				"from": 497760,
				"to": 501220
			},
			"text": "其实用分镜讲故事从来都不是难事"
		},
		{
			"timestamps": {
				"from": "00:08:21,220",
				"to": "00:08:27,360"
			},
			"offsets": {
				"from": 501220,
				"to": 507360
			},
			"text": "但是如何把分镜用对用准用的生动用的恰到好处"
		},
		{
			"timestamps": {
				"from": "00:08:27,360",
				"to": "00:08:30,600"
			},
			"offsets": {
				"from": 507360,
				"to": 510600
			},
			"text": "这个就是导演思维需要解决的事"
		},
		{
			"timestamps": {
				"from": "00:08:30,600",
				"to": "00:08:33,240"
			},
			"offsets": {
				"from": 510600,
				"to": 513240
			},
			"text": "总而言之这一期主题它并不复杂"
		},
		{
			"timestamps": {
				"from": "00:08:33,240",
				"to": "00:08:36,100"
			},
			"offsets": {
				"from": 513240,
				"to": 516100
			},
			"text": "但是作为新人和小白他并不知道"
		},
		{
			"timestamps": {
				"from": "00:08:36,100",
				"to": "00:08:39,580"
			},
			"offsets": {
				"from": 516100,
				"to": 519580
			},
			"text": "这个事一旦不知道往往就会走弯路"
		},
		{
			"timestamps": {
				"from": "00:08:39,580",
				"to": "00:08:41,300"
			},
			"offsets": {
				"from": 519580,
				"to": 521300
			},
			"text": "这弯路一旦走上去"
		},
		{
			"timestamps": {
				"from": "00:08:41,300",
				"to": "00:08:44,060"
			},
			"offsets": {
				"from": 521300,
				"to": 524060
			},
			"text": "可不是一时半会儿就能够绕出来"
		},
		{
			"timestamps": {
				"from": "00:08:44,060",
				"to": "00:08:45,140"
			},
			"offsets": {
				"from": 524060,
				"to": 525140
			},
			"text": "有的几个月"
		},
		{
			"timestamps": {
				"from": "00:08:45,140",
				"to": "00:08:46,460"
			},
			"offsets": {
				"from": 525140,
				"to": 526460
			},
			"text": "有的三五年"
		},
		{
			"timestamps": {
				"from": "00:08:46,460",
				"to": "00:08:48,380"
			},
			"offsets": {
				"from": 526460,
				"to": 528380
			},
			"text": "有的甚至更长"
		},
		{
			"timestamps": {
				"from": "00:08:48,380",
				"to": "00:08:50,240"
			},
			"offsets": {
				"from": 528380,
				"to": 530240
			},
			"text": "最后咱们回归到原点"
		},
		{
			"timestamps": {
				"from": "00:08:50,240",
				"to": "00:08:53,360"
			},
			"offsets": {
				"from": 530240,
				"to": 533360
			},
			"text": "学习分镜要先学导演思维"
		},
		{
			"timestamps": {
				"from": "00:08:53,360",
				"to": "00:08:55,420"
			},
			"offsets": {
				"from": 533360,
				"to": 535420
			},
			"text": "先学导演工具"
		},
		{
			"timestamps": {
				"from": "00:08:55,420",
				"to": "00:08:57,860"
			},
			"offsets": {
				"from": 535420,
				"to": 537860
			},
			"text": "然后再学叙事的方法"
		},
		{
			"timestamps": {
				"from": "00:08:57,860",
				"to": "00:09:00,100"
			},
			"offsets": {
				"from": 537860,
				"to": 540100
			},
			"text": "这个方法包括镜头的设计"
		},
		{
			"timestamps": {
				"from": "00:09:00,100",
				"to": "00:09:02,020"
			},
			"offsets": {
				"from": 540100,
				"to": 542020
			},
			"text": "包括剪辑思维的前置"
		},
		{
			"timestamps": {
				"from": "00:09:02,020",
				"to": "00:09:04,440"
			},
			"offsets": {
				"from": 542020,
				"to": 544440
			},
			"text": "然后再学导演套路"
		},
		{
			"timestamps": {
				"from": "00:09:04,440",
				"to": "00:09:09,280"
			},
			"offsets": {
				"from": 544440,
				"to": 549280
			},
			"text": "导演思维如何具体的呈现在每一个场景里面"
		},
		{
			"timestamps": {
				"from": "00:09:09,280",
				"to": "00:09:11,880"
			},
			"offsets": {
				"from": 549280,
				"to": 551880
			},
			"text": "这些都属于是导演思维的基础"
		},
		{
			"timestamps": {
				"from": "00:09:11,880",
				"to": "00:09:16,600"
			},
			"offsets": {
				"from": 551880,
				"to": 556600
			},
			"text": "然后再往上学抽象的就是情绪化的设计"
		},
		{
			"timestamps": {
				"from": "00:09:16,600",
				"to": "00:09:18,880"
			},
			"offsets": {
				"from": 556600,
				"to": 558880
			},
			"text": "以及节奏化的表达"
		},
		{
			"timestamps": {
				"from": "00:09:18,880",
				"to": "00:09:21,600"
			},
			"offsets": {
				"from": 558880,
				"to": 561600
			},
			"text": "同时还有观众的心理控制"
		},
		{
			"timestamps": {
				"from": "00:09:21,600",
				"to": "00:09:24,360"
			},
			"offsets": {
				"from": 561600,
				"to": 564360
			},
			"text": "这是一个由简路凡层层递进"
		},
		{
			"timestamps": {
				"from": "00:09:24,360",
				"to": "00:09:28,000"
			},
			"offsets": {
				"from": 564360,
				"to": 568000
			},
			"text": "由外延到内核的一个训练过程"
		},
		{
			"timestamps": {
				"from": "00:09:28,000",
				"to": "00:09:28,720"
			},
			"offsets": {
				"from": 568000,
				"to": 568720
			},
			"text": "很遗憾"
		},
		{
			"timestamps": {
				"from": "00:09:28,720",
				"to": "00:09:31,160"
			},
			"offsets": {
				"from": 568720,
				"to": 571160
			},
			"text": "他无法一上来就达到高潮"
		},
		{
			"timestamps": {
				"from": "00:09:31,160",
				"to": "00:09:33,640"
			},
			"offsets": {
				"from": 571160,
				"to": 573640
			},
			"text": "因为他得一步一步的走"
		},
		{
			"timestamps": {
				"from": "00:09:33,640",
				"to": "00:09:37,480"
			},
			"offsets": {
				"from": 573640,
				"to": 577480
			},
			"text": "因为他属于是创作思维的不断升级"
		},
		{
			"timestamps": {
				"from": "00:09:37,480",
				"to": "00:09:40,720"
			},
			"offsets": {
				"from": 577480,
				"to": 580720
			},
			"text": "而不是普通技术的重复应用"
		},
		{
			"timestamps": {
				"from": "00:09:40,720",
				"to": "00:09:42,200"
			},
			"offsets": {
				"from": 580720,
				"to": 582200
			},
			"text": "升级你的思维"
		},
		{
			"timestamps": {
				"from": "00:09:42,200",
				"to": "00:09:45,600"
			},
			"offsets": {
				"from": 582200,
				"to": 585600
			},
			"text": "而不是在那些普通的技术里面打转"
		},
		{
