				"from": 0,
				"to": 27320
			},
			"text": " Hi, I'm Adil, and what you just watched is an action short film made in Seedance in 4K."
		},
		{
			"timestamps": {
				"from": "00:00:27,320",
				"to": "00:00:28,320"
			},
			"offsets": {
				"from": 27320,
				"to": 28320
			},
			"text": " Crazy, right?"
		},
		{
			"timestamps": {
				"from": "00:00:28,320",
				"to": "00:00:31,760"
			},
			"offsets": {
				"from": 28320,
				"to": 31760
			},
			"text": " So, today we're breaking down how to build shots like these across completely different"
		},
		{
			"timestamps": {
				"from": "00:00:31,760",
				"to": "00:00:32,760"
