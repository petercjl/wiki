				"to": 32760
			},
			"text": " settings."
		},
		{
			"timestamps": {
				"from": "00:00:32,760",
				"to": "00:00:38,360"
			},
			"offsets": {
				"from": 32760,
				"to": 38360
			},
			"text": " A storm at sea, a desert, a jungle full of monkeys, you learn how to make shots that actually"
		},
		{
			"timestamps": {
				"from": "00:00:38,360",
				"to": "00:00:43,840"
			},
			"offsets": {
				"from": 38360,
				"to": 43840
			},
			"text": " look cinematic, how to carry a story from the first scene to the twist, and how to do"
		},
		{
			"timestamps": {
				"from": "00:00:43,840",
				"to": "00:00:46,660"
			},
			"offsets": {
				"from": 43840,
				"to": 46660
			},
			"text": " it without burning credits on random generations."
		},
		{
			"timestamps": {
				"from": "00:00:46,660",
				"to": "00:00:48,920"
			},
			"offsets": {
				"from": 46660,
				"to": 48920
			},
			"text": " And you don't need to write anything down."
		},
		{
			"timestamps": {
				"from": "00:00:48,920",
				"to": "00:00:54,040"
			},
			"offsets": {
				"from": 48920,
				"to": 54040
			},
			"text": " Everything from this video is in one blog post, the script, the prompts, the asset sheets,"
		},
