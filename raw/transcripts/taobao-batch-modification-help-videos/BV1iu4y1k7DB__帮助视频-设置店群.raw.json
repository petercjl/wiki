			},
			"offsets": {
				"from": 135000,
				"to": 140000
			},
			"text": "在这里您可以看到,就是刚才那个组电的号邀请您加入他的店群试播加入。"
		},
		{
			"timestamps": {
				"from": "00:02:20,000",
