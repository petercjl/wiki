			},
			"offsets": {
				"from": 172000,
				"to": 176000
			},
			"text": "这里而且它在这个里面的数据也都能显示出来了。"
		},
		{
			"timestamps": {
				"from": "00:02:56,000",
				"to": "00:02:59,000"
			},
			"offsets": {
				"from": 176000,
				"to": 179000
			},
			"text": "这就说明这个分店已经成功的添加好了。"
		},
		{
			"timestamps": {
				"from": "00:02:59,000",
				"to": "00:03:03,000"
			},
			"offsets": {
				"from": 179000,
				"to": 183000
			},
			"text": "如果您有多个分店的话,可以点击这个按钮一次的吧。"
		},
		{
			"timestamps": {
				"from": "00:03:03,000",
				"to": "00:03:05,000"
			},
			"offsets": {
				"from": 183000,
				"to": 185000
			},
			"text": "所有的分店都添加进来。"
		},
		{
			"timestamps": {
				"from": "00:03:05,000",
				"to": "00:03:08,000"
			},
			"offsets": {
				"from": 185000,
				"to": 188000
			},
			"text": "这样的话,您整个这个店群就设置好了。"
		},
		{
			"timestamps": {
				"from": "00:03:08,000",
				"to": "00:03:15,000"
			},
			"offsets": {
				"from": 188000,
				"to": 195000
			},
			"text": "设置好店群之后,您后续的操作只需要用组电这个号来登录,登录到软件里面进行操作。"
		},
		{
			"timestamps": {
				"from": "00:03:15,000",
				"to": "00:03:20,000"
			},
			"offsets": {
				"from": 195000,
