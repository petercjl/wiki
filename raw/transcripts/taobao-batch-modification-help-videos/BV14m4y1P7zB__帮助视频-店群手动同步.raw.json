	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:08,000"
			},
			"offsets": {
				"from": 0,
				"to": 8000
			},
			"text": "大家好,现在我来给大家介绍一下店群模式下怎样进行手动同步数据。"
		},
		{
			"timestamps": {
				"from": "00:00:08,000",
				"to": "00:00:15,000"
			},
			"offsets": {
				"from": 8000,
				"to": 15000
			},
			"text": "在之前的介绍中,我们已经设置好了店群,有主电和分电。"
		},
		{
			"timestamps": {
				"from": "00:00:15,000",
				"to": "00:00:18,000"
			},
			"offsets": {
				"from": 15000,
				"to": 18000
			},
			"text": "接下来我们要进行手动同步数据。"
		},
		{
			"timestamps": {
				"from": "00:00:18,000",
				"to": "00:00:25,000"
			},
			"offsets": {
				"from": 18000,
				"to": 25000
			},
			"text": "手动同步数据主要用在商品的一些数据属性,"
		},
		{
			"timestamps": {
				"from": "00:00:25,000",
				"to": "00:00:32,000"
			},
			"offsets": {
				"from": 25000,
				"to": 32000
			},
			"text": "例如图片，组图，价格，描述，做了一些变动。"
		},
		{
			"timestamps": {
				"from": "00:00:32,000",
				"to": "00:00:39,000"
			},
			"offsets": {
				"from": 32000,
				"to": 39000
			},
			"text": "那么想把这些变动被同步到另外一个店铺的对等商品上。"
		},
		{
			"timestamps": {
				"from": "00:00:39,000",
				"to": "00:00:43,000"
			},
			"offsets": {
				"from": 39000,
				"to": 43000
			},
			"text": "这个时候我们要用到手动同步。"
		},
		{
			"timestamps": {
				"from": "00:00:43,000",
				"to": "00:00:47,000"
			},
			"offsets": {
				"from": 43000,
				"to": 47000
			},
			"text": "我们首先需要创建一个同步的规则。"
		},
		{
			"timestamps": {
				"from": "00:00:55,000",
				"to": "00:00:58,000"
			},
			"offsets": {
				"from": 55000,
				"to": 58000
			},
			"text": "这边要绑定模式，有两种。"
		},
		{
			"timestamps": {
				"from": "00:00:58,000",
				"to": "00:01:03,000"
			},
			"offsets": {
				"from": 58000,
				"to": 63000
			},
			"text": "第一种是用商家编码，如果您这两个店铺的对等商品。"
		},
		{
			"timestamps": {
				"from": "00:01:03,000",
				"to": "00:01:08,000"
			},
			"offsets": {
				"from": 63000,
				"to": 68000
			},
			"text": "商家编码是相同的并且在整个店铺里都是唯一的。"
		},
		{
			"timestamps": {
				"from": "00:01:08,000",
				"to": "00:01:10,000"
			},
			"offsets": {
				"from": 68000,
				"to": 70000
			},
			"text": "那么您可以用这种。"
		},
		{
			"timestamps": {
				"from": "00:01:10,000",
				"to": "00:01:18,000"
			},
			"offsets": {
				"from": 70000,
				"to": 78000
			},
			"text": "另外一种就是您可以选择用实时同步处的所配置的关联关系来做绑定模式。"
		},
		{
			"timestamps": {
				"from": "00:01:18,000",
				"to": "00:01:24,000"
			},
			"offsets": {
				"from": 78000,
				"to": 84000
			},
			"text": "就说在它的下面这个菜单里,那里是可以设置它的关联关系的。"
		},
		{
			"timestamps": {
				"from": "00:01:24,000",
				"to": "00:01:27,000"
			},
			"offsets": {
				"from": 84000,
				"to": 87000
			},
			"text": "如果那里有的话,您也可以用这种。"
		},
		{
			"timestamps": {
				"from": "00:01:27,000",
				"to": "00:01:32,000"
			},
			"offsets": {
				"from": 87000,
				"to": 92000
			},
			"text": "我们先来用商家编码。"
		},
		{
			"timestamps": {
				"from": "00:01:32,000",
				"to": "00:01:37,000"
			},
			"offsets": {
				"from": 92000,
				"to": 97000
			},
			"text": "这下面的话,您是需要设置的,就是说我要同步的一些数据。"
		},
		{
			"timestamps": {
				"from": "00:01:37,000",
				"to": "00:01:42,000"
			},
			"offsets": {
				"from": 97000,
				"to": 102000
			},
			"text": "比如说要同步商家家的状态,或者说库存变动了,我叫同步库存。"
		},
		{
			"timestamps": {
				"from": "00:01:42,000",
				"to": "00:01:50,000"
			},
			"offsets": {
				"from": 102000,
				"to": 110000
			},
			"text": "或者说SKU,用的比较多的,比如说主电的这个宝贝它添加了SKU,"
		},
		{
			"timestamps": {
				"from": "00:01:50,000",
				"to": "00:01:54,000"
			},
			"offsets": {
				"from": 110000,
				"to": 114000
			},
			"text": "我也要把它同样的添加到分电这个宝贝里,那可以用这个。"
		},
		{
			"timestamps": {
				"from": "00:01:54,000",
				"to": "00:02:01,000"
			},
			"offsets": {
				"from": 114000,
				"to": 121000
			},
			"text": "其他的比如说价格的一些变动,包括组图,组图的变动,其他组图,"
		},
		{
			"timestamps": {
				"from": "00:02:01,000",
				"to": "00:02:08,000"
			},
			"offsets": {
				"from": 121000,
				"to": 128000
			},
			"text": "就是这是第一张首图,这是相当于后面几张,其他除了第一张之外的组图。"
		},
		{
			"timestamps": {
				"from": "00:02:08,000",
				"to": "00:02:12,000"
			},
			"offsets": {
				"from": 128000,
				"to": 132000
			},
			"text": "然后这边是属性图片,就是说颜色的那些图片。"
		},
		{
			"timestamps": {
				"from": "00:02:12,000",
				"to": "00:02:19,000"
			},
			"offsets": {
				"from": 132000,
				"to": 139000
			},
			"text": "还有描述,电脑描述,手机描述,这些都是可以去选择的同步。"
		},
		{
			"timestamps": {
				"from": "00:02:19,000",
				"to": "00:02:24,000"
			},
			"offsets": {
				"from": 139000,
				"to": 144000
			},
			"text": "因为这里还有一个实时同步,如果您勾选了,"
		},
		{
			"timestamps": {
				"from": "00:02:24,000",
				"to": "00:02:30,000"
			},
			"offsets": {
				"from": 144000,
				"to": 150000
			},
			"text": "那么在这个同步之后的话,会自动把给这两个商品生成,"
		},
		{
			"timestamps": {
				"from": "00:02:30,000",
				"to": "00:02:36,000"
			},
			"offsets": {
				"from": 150000,
				"to": 156000
			},
			"text": "实时同步出所需要的那个关联关系并且开始后续的话,"
		},
		{
			"timestamps": {
				"from": "00:02:36,000",
				"to": "00:02:39,000"
			},
			"offsets": {
				"from": 156000,
				"to": 159000
			},
			"text": "这两个商品会开启实时同步。"
		},
		{
			"timestamps": {
				"from": "00:02:39,000",
				"to": "00:02:42,000"
			},
			"offsets": {
				"from": 159000,
				"to": 162000
			},
			"text": "这个您根据需求来选。"
		},
		{
			"timestamps": {
				"from": "00:02:43,000",
				"to": "00:02:49,000"
			},
			"offsets": {
				"from": 163000,
				"to": 169000
			},
			"text": "我们先来选择一下库存和SQ来做一个测试。"
		},
		{
			"timestamps": {
				"from": "00:02:49,000",
				"to": "00:02:58,000"
			},
			"offsets": {
				"from": 169000,
				"to": 178000
			},
			"text": "在这里的话,您可以随时查看,进行或者说编辑,或者删除这条规则。"
		},
		{
			"timestamps": {
				"from": "00:02:58,000",
				"to": "00:03:05,000"
			},
			"offsets": {
				"from": 178000,
				"to": 185000
			},
			"text": "接下来我们来进行走动同步,选择商品同步,"
		},
		{
			"timestamps": {
				"from": "00:03:05,000",
				"to": "00:03:11,000"
			},
			"offsets": {
				"from": 185000,
				"to": 191000
			},
			"text": "然后这里有源店铺,您要把哪个店铺的商品给同步过去呢?"
		},
		{
			"timestamps": {
				"from": "00:03:11,000",
				"to": "00:03:20,000"
			},
			"offsets": {
				"from": 191000,
				"to": 200000
			},
			"text": "比如说现在选择主店,比如说我要把这个商品给同步过去,"
		},
		{
			"timestamps": {
				"from": "00:03:20,000",
				"to": "00:03:22,000"
			},
			"offsets": {
				"from": 200000,
				"to": 202000
			},
			"text": "点击立即同步。"
		},
		{
			"timestamps": {
				"from": "00:03:22,000",
				"to": "00:03:30,000"
			},
			"offsets": {
				"from": 202000,
				"to": 210000
			},
			"text": "我要给店铺二这边的同步,选择刚才这个规则,"
		},
		{
			"timestamps": {
				"from": "00:03:30,000",
				"to": "00:03:34,000"
			},
			"offsets": {
				"from": 210000,
				"to": 214000
			},
			"text": "在这里的话您也可以查看这个规则或者进行编辑。"
		},
		{
			"timestamps": {
				"from": "00:03:35,000",
				"to": "00:03:42,000"
			},
			"offsets": {
				"from": 215000,
				"to": 222000
			},
			"text": "好了,那接下来您自己点击一下确定,那就会把主店的这个SQ,比如说多了几个SQ,"
		},
		{
			"timestamps": {
				"from": "00:03:42,000",
				"to": "00:03:45,000"
			},
			"offsets": {
				"from": 222000,
				"to": 225000
			},
			"text": "就可以同步到同步更新给分店了。"
		},
		{
			"timestamps": {
				"from": "00:03:45,000",
				"to": "00:03:52,000"
			},
			"offsets": {
				"from": 225000,
				"to": 232000
			},
			"text": "这里提示提交成功,去查看这个同步,任务。"
		},
		{
			"timestamps": {
				"from": "00:03:52,000",
				"to": "00:04:01,000"
			},
			"offsets": {
				"from": 232000,
				"to": 241000
			},
			"text": "如果这个任务的话,还没有开始,您是可以随时测销的。"
		},
		{
			"timestamps": {
				"from": "00:04:04,000",
				"to": "00:04:14,000"
			},
			"offsets": {
				"from": 244000,
				"to": 254000
			},
			"text": "好了,您看一下,这里显示已经同步成功,那么点击这个任务的ID,可以跳转到这个同步纪录,"
		},
		{
			"timestamps": {
				"from": "00:04:14,000",
				"to": "00:04:23,000"
			},
			"offsets": {
				"from": 254000,
				"to": 263000
			},
			"text": "您可以查看这是刚才手动同步的那么一条纪录,从源店铺的某个商品同步给分店铺的某个商品。"
		},
		{
			"timestamps": {
				"from": "00:04:24,000",
				"to": "00:04:40,000"
			},
			"offsets": {
				"from": 264000,
				"to": 280000
			},
			"text": "看它的编号是多少,同步状态以及时间,都可以看到,可以导出同步纪录,同样的话如果有失败的,您可以直接把失败的查询出来,点击重新同步,可以对这些失败的进行重新的同步。"
		},
		{
			"timestamps": {
				"from": "00:04:40,000",
				"to": "00:04:45,000"
			},
			"offsets": {
				"from": 280000,
				"to": 285000
			},
			"text": "好了,这些就是给大家介绍的手动同步数据,谢谢。"
		}
	]
}
