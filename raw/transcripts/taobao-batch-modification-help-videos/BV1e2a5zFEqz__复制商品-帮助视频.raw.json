	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:16,000"
			},
			"offsets": {
				"from": 0,
				"to": 16000
			},
			"text": "下面我为大家演示一下如何复制商品,首先点击左边菜单的授权复制,进来后点击设置模板,点击添加模板,模板名称可以自定义,方便您管理和识别。"
		},
		{
			"timestamps": {
				"from": "00:00:16,000",
				"to": "00:00:23,000"
			},
			"offsets": {
				"from": 16000,
				"to": 23000
			},
			"text": "下方的内容根据需求设置,后续复制的商品会按照这个模板设置的规则来进行。"
		},
		{
			"timestamps": {
				"from": "00:00:23,000",
				"to": "00:00:33,000"
			},
			"offsets": {
				"from": 23000,
				"to": 33000
			},
			"text": "价格这里,根据实际情况,可以设置階梯价格,也可以设置单一价格。"
		},
		{
			"timestamps": {
				"from": "00:00:33,000",
				"to": "00:00:37,000"
			},
			"offsets": {
				"from": 33000,
				"to": 37000
			},
			"text": "设置以后点击加号,价格就设置好了。"
		},
		{
			"timestamps": {
				"from": "00:00:37,000",
				"to": "00:00:41,000"
			},
			"offsets": {
				"from": 37000,
				"to": 41000
			},
			"text": "页面的最下方,有一个商品过滤默认是勾选的。"
		},
		{
			"timestamps": {
				"from": "00:00:41,000",
				"to": "00:00:46,000"
			},
			"offsets": {
				"from": 41000,
				"to": 46000
			},
			"text": "如果您不需要过滤取消勾选,点击确定就可以了。"
		},
		{
			"timestamps": {
				"from": "00:00:46,000",
				"to": "00:00:49,000"
			},
			"offsets": {
				"from": 46000,
				"to": 49000
			},
			"text": "接下来点击选择商品复制。"
		},
		{
			"timestamps": {
				"from": "00:00:49,000",
				"to": "00:00:54,000"
			},
			"offsets": {
				"from": 49000,
				"to": 54000
			},
			"text": "先选择分组和源店铺,源店铺就是有商品的店铺。"
		},
		{
			"timestamps": {
				"from": "00:00:54,000",
				"to": "00:01:02,000"
			},
			"offsets": {
				"from": 54000,
				"to": 62000
			},
			"text": "如果不是全店复制,还可以根据条件进行筛选。"
		},
		{
			"timestamps": {
				"from": "00:01:02,000",
				"to": "00:01:07,000"
			},
			"offsets": {
				"from": 62000,
				"to": 67000
			},
			"text": "还可以点击复制标记,选择未复制的商品。"
		},
		{
			"timestamps": {
				"from": "00:01:07,000",
				"to": "00:01:10,000"
			},
			"offsets": {
				"from": 67000,
				"to": 70000
			},
			"text": "点击查询。"
		},
		{
			"timestamps": {
				"from": "00:01:10,000",
				"to": "00:01:12,000"
			},
			"offsets": {
				"from": 70000,
				"to": 72000
			},
			"text": "选择商品。"
		},
		{
			"timestamps": {
				"from": "00:01:12,000",
				"to": "00:01:15,000"
			},
			"offsets": {
				"from": 72000,
				"to": 75000
			},
			"text": "商品支持翻页选择。"
		},
		{
			"timestamps": {
				"from": "00:01:15,000",
				"to": "00:01:20,000"
			},
			"offsets": {
				"from": 75000,
				"to": 80000
			},
			"text": "选好后,点击立即复制,会出现您选中的商品。"
		},
		{
			"timestamps": {
				"from": "00:01:20,000",
				"to": "00:01:25,000"
			},
			"offsets": {
				"from": 80000,
				"to": 85000
			},
			"text": "这里您可以核对一下,显示的数量和您选中的商品是否一致。"
		},
		{
			"timestamps": {
				"from": "00:01:25,000",
				"to": "00:01:27,000"
			},
			"offsets": {
				"from": 85000,
				"to": 87000
			},
			"text": "一致的话,点击。"
		},
		{
			"timestamps": {
				"from": "00:01:27,000",
				"to": "00:01:29,000"
			},
			"offsets": {
				"from": 87000,
				"to": 89000
			},
			"text": "会弹出下一步。"
		},
		{
			"timestamps": {
				"from": "00:01:29,000",
				"to": "00:01:34,000"
			},
			"offsets": {
				"from": 89000,
				"to": 94000
			},
			"text": "这个页面会出现您这里添加的所有店铺。"
		},
		{
			"timestamps": {
				"from": "00:01:34,000",
				"to": "00:01:40,000"
			},
			"offsets": {
				"from": 94000,
				"to": 100000
			},
			"text": "您要复制到哪个店铺,就在哪个店铺这里选择复制模板。"
		},
		{
			"timestamps": {
				"from": "00:01:40,000",
				"to": "00:01:43,000"
			},
			"offsets": {
				"from": 100000,
				"to": 103000
			},
			"text": "这里请注意,因为源店铺也会显示在这里。"
		},
		{
			"timestamps": {
				"from": "00:01:43,000",
				"to": "00:01:47,000"
			},
			"offsets": {
				"from": 103000,
				"to": 107000
			},
			"text": "所以,如果源店铺不需要复制的话,就不用勾选。"
		},
		{
			"timestamps": {
				"from": "00:01:47,000",
				"to": "00:01:49,000"
			},
			"offsets": {
				"from": 107000,
				"to": 109000
			},
			"text": "点击确定。"
		},
		{
			"timestamps": {
				"from": "00:01:49,000",
				"to": "00:01:53,000"
			},
			"offsets": {
				"from": 109000,
				"to": 113000
			},
			"text": "复制任务就创建好了。"
		},
		{
			"timestamps": {
				"from": "00:01:53,000",
				"to": "00:01:57,000"
			},
			"offsets": {
				"from": 113000,
				"to": 117000
			},
			"text": "这个页面还有一个修改复制标记的功能。"
		},
		{
			"timestamps": {
				"from": "00:01:57,000",
				"to": "00:02:05,000"
			},
			"offsets": {
				"from": 117000,
				"to": 125000
			},
			"text": "比如您店铺有些商品不需要复制,可以选择这些商品。"
		},
		{
			"timestamps": {
				"from": "00:02:05,000",
				"to": "00:02:07,000"
			},
			"offsets": {
				"from": 125000,
				"to": 127000
			},
			"text": "标记为您复制。"
		},
		{
			"timestamps": {
				"from": "00:02:07,000",
				"to": "00:02:15,000"
			},
			"offsets": {
				"from": 127000,
				"to": 135000
			},
			"text": "这样您在会复制的这个进行筛选。标记为以复制的商品就不会显示了。"
		},
		{
			"timestamps": {
				"from": "00:02:15,000",
				"to": "00:02:21,000"
			},
			"offsets": {
				"from": 135000,
				"to": 141000
			},
			"text": "最后点击查看复制记录,可以查看您提交的任务。"
		},
		{
			"timestamps": {
				"from": "00:02:21,000",
				"to": "00:02:25,000"
			},
			"offsets": {
				"from": 141000,
				"to": 145000
			},
			"text": "点击详细,可以查看实际的复制进度和详情。"
		},
		{
			"timestamps": {
				"from": "00:02:25,000",
				"to": "00:02:27,000"
			},
			"offsets": {
				"from": 145000,
				"to": 147000
			},
			"text": "可以根据复制的状态进行筛选。"
		},
		{
			"timestamps": {
				"from": "00:02:27,000",
				"to": "00:02:35,000"
			},
			"offsets": {
				"from": 147000,
				"to": 155000
			},
			"text": "如果发现有复制失败的商品,可以根据失败提示的内容进行修改,然后重新复制。"
		},
		{
			"timestamps": {
				"from": "00:02:35,000",
				"to": "00:02:36,000"
			},
			"offsets": {
				"from": 155000,
				"to": 156000
			},
			"text": "謝謝"
		}
	]
}
