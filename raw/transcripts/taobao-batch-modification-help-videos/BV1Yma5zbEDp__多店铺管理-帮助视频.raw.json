	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:05,000"
			},
			"offsets": {
				"from": 0,
				"to": 5000
			},
			"text": "大家好，接下来我演示一下如何同时管理多个店铺。"
		},
		{
			"timestamps": {
				"from": "00:00:05,000",
				"to": "00:00:11,000"
			},
			"offsets": {
				"from": 5000,
				"to": 11000
			},
			"text": "登入软件后,点击左侧，我的店铺菜单,进入店铺管理页面。"
		},
		{
			"timestamps": {
				"from": "00:00:11,000",
				"to": "00:00:15,000"
			},
			"offsets": {
				"from": 11000,
				"to": 15000
			},
			"text": "您会看到,当前登入的店铺已经自动添加好了。"
		},
		{
			"timestamps": {
				"from": "00:00:15,000",
				"to": "00:00:21,000"
			},
			"offsets": {
				"from": 15000,
				"to": 21000
			},
			"text": "如果想管理其他店铺,只需将其他店铺主一添加进来就可以。"
		},
		{
			"timestamps": {
				"from": "00:00:21,000",
				"to": "00:00:24,000"
			},
			"offsets": {
				"from": 21000,
				"to": 24000
			},
			"text": "点击添加店铺,会弹出一个窗口。"
		},
		{
			"timestamps": {
				"from": "00:00:24,000",
				"to": "00:00:27,000"
			},
			"offsets": {
				"from": 24000,
				"to": 27000
			},
			"text": "在这里粘贴其他店铺的授权码。"
		},
		{
			"timestamps": {
				"from": "00:00:27,000",
				"to": "00:00:31,000"
			},
			"offsets": {
				"from": 27000,
				"to": 31000
			},
			"text": "在选择分组,点击确认,就可以完成添加。"
		},
		{
			"timestamps": {
				"from": "00:00:31,000",
				"to": "00:00:33,000"
			},
			"offsets": {
				"from": 31000,
				"to": 33000
			},
			"text": "获取授权码很简单。"
		},
		{
			"timestamps": {
				"from": "00:00:33,000",
				"to": "00:00:40,000"
			},
			"offsets": {
				"from": 33000,
				"to": 40000
			},
			"text": "您用其他店铺,登入软件后,点击软件右上方的复制授权码就能获取。"
		},
		{
			"timestamps": {
				"from": "00:00:40,000",
				"to": "00:00:45,000"
			},
			"offsets": {
				"from": 40000,
				"to": 45000
			},
			"text": "如果店铺数量比较多,建议使用分组功能来分类管理。"
		},
		{
			"timestamps": {
				"from": "00:00:45,000",
				"to": "00:00:49,000"
			},
			"offsets": {
				"from": 45000,
				"to": 49000
			},
			"text": "比如,按照业务类型,或者按照活动分类。"
		},
		{
			"timestamps": {
				"from": "00:00:53,000",
				"to": "00:00:58,000"
			},
			"offsets": {
				"from": 53000,
				"to": 58000
			},
			"text": "如果暂时不想分组,也可以直接选择默认分组。"
		},
		{
			"timestamps": {
				"from": "00:00:58,000",
				"to": "00:01:03,000"
			},
			"offsets": {
				"from": 58000,
				"to": 63000
			},
			"text": "您也可以随时调整分组和添加备注。"
		},
		{
			"timestamps": {
				"from": "00:01:03,000",
				"to": "00:01:08,000"
			},
			"offsets": {
				"from": 63000,
				"to": 68000
			},
			"text": "比如30号有大醋,我可以给这个店铺加上一个备注。"
		},
		{
			"timestamps": {
				"from": "00:01:08,000",
				"to": "00:01:14,000"
			},
			"offsets": {
				"from": 68000,
				"to": 74000
			},
			"text": "方便后续的识别和操作。"
		}
	]
}
