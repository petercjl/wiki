#!/usr/bin/env sh
set -eu

remote_name="${1:-}"
remote_url="${2:-}"

case "$remote_url" in
  *gitee.com*|git@gitee.com:*|https://gitee.com/*)
    echo "Refusing to push wiki content to the retired Gitee remote: ${remote_name} (${remote_url})" >&2
    echo "This wiki has migrated back to GitHub." >&2
    exit 1
    ;;
esac

if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@"
else
  echo "Git LFS is required to push this Wiki branch." >&2
  exit 1
fi

exit 0
